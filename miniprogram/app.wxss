/* 全局样式 - 县域房产信息平台 */

/* 重置样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #333;
}

/* 通用容器 */
.container {
  padding: 20rpx;
}

.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 通用按钮 */
.btn-primary {
  background-color: #667eea;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: #fff;
  color: #667eea;
  border: 1rpx solid #667eea;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-default {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

.btn-default::after {
  border: none;
}

.btn-danger {
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-danger::after {
  border: none;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #e8e8e8;
  margin: 20rpx 0;
}

/* 文本样式 */
.text-primary {
  color: #667eea;
}

.text-success {
  color: #52c41a;
}

.text-warning {
  color: #faad14;
}

.text-danger {
  color: #ff4d4f;
}

.text-secondary {
  color: #8c8c8c;
}

.text-price {
  color: #ff4d4f;
  font-weight: bold;
}

/* 间距工具类 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }

/* Flex布局 */
.flex {
  display: flex;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.align-center {
  align-items: center;
}

/* 文本截断 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #8c8c8c;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #8c8c8c;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.tag-primary {
  background-color: #e6e9ff;
  color: #667eea;
  border: 1rpx solid #b3b8e8;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.tag-warning {
  background-color: #fffbe6;
  color: #faad14;
  border: 1rpx solid #ffe58f;
}

/* 渐变背景 */
.gradient-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* 搜索框 */
.search-bar {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 8rpx;
}

.search-input {
  background-color: #f5f5f5;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

/* 列表项 */
.list-item {
  background-color: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.list-item:last-child {
  border-bottom: none;
}

/* 图片 */
.image {
  width: 100%;
  height: 100%;
}

/* 价格样式 */
.price {
  color: #ff4d4f;
  font-size: 32rpx;
  font-weight: bold;
}

.price-unit {
  font-size: 20rpx;
  margin-right: 4rpx;
}

.price-integer {
  font-size: 32rpx;
}

.price-decimal {
  font-size: 20rpx;
}
