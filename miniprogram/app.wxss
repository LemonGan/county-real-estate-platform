/* ========================================
   县域房产平台 - 全局样式 & 设计令牌
   ======================================== */

/* 设计令牌 */
page {
  --color-primary: #667eea;
  --color-primary-dark: #5a6fd6;
  --color-accent: #764ba2;
  --color-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --color-success: #52c41a;
  --color-success-bg: #f6ffed;
  --color-warning: #fa8c16;
  --color-warning-bg: #fff7e6;
  --color-danger: #ff4d4f;
  --color-danger-bg: #fff2f0;
  --color-price: #ff4d4f;
  --color-bg: #f5f7fa;
  --color-card: #ffffff;
  --color-text-primary: #1a1a2e;
  --color-text-secondary: #666666;
  --color-text-hint: #999999;
  --color-border: #f0f0f0;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-round: 48rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0,0,0,0.08);
  --shadow-xl: 0 12rpx 32rpx rgba(0,0,0,0.12);
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: var(--font-md);
  color: var(--color-text-primary);
  line-height: 1.5;
}

/* ===== 通用卡片入场动画 ===== */
@keyframes fadeInUp {
  from  { opacity: 0; transform: translateY(24rpx); }
  to    { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from  { opacity: 0; }
  to    { opacity: 1; }
}
@keyframes scaleIn {
  from  { opacity: 0; transform: scale(0.92); }
  to    { opacity: 1; transform: scale(1); }
}

.card-animate {
  animation: fadeInUp 0.35s ease-out both;
}
.card-animate-fast {
  animation: fadeInUp 0.25s ease-out both;
}

/* ===== 骨架屏 ===== */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite ease-in-out;
  border-radius: var(--radius-sm);
}
@keyframes skeleton-loading {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.skeleton-card {
  display: flex; padding: 24rpx; background: var(--color-card);
  border-radius: var(--radius-lg); margin: 0 30rpx 20rpx;
}
.skeleton-img { width: 200rpx; height: 150rpx; flex-shrink: 0; }
.skeleton-content { flex: 1; margin-left: 20rpx; }
.skeleton-line { height: 28rpx; margin-bottom: 12rpx; }
.skeleton-line:last-child { width: 60%; }

/* ===== 空状态 ===== */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 120rpx 40rpx;
}
.empty-state-icon { font-size: 100rpx; margin-bottom: 24rpx; opacity: 0.6; }
.empty-state-text { font-size: var(--font-md); color: var(--color-text-hint); }
.empty-state-hint { font-size: var(--font-sm); color: #ccc; margin-top: 8rpx; }
.empty-state-btn {
  margin-top: 32rpx; padding: 16rpx 48rpx;
  background: var(--color-primary); color: #fff;
  border-radius: var(--radius-round); font-size: var(--font-md);
}

/* ===== 按钮 ===== */
.btn-primary {
  background: var(--color-gradient); color: #fff;
  border-radius: var(--radius-round); padding: 24rpx 0;
  font-size: var(--font-lg); font-weight: 500; text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(102,126,234,0.3);
  transition: opacity 0.2s;
}
.btn-primary:active { opacity: 0.85; }

/* ===== 标签 ===== */
.tag { display: inline-block; padding: 6rpx 16rpx; font-size: var(--font-xs); border-radius: 8rpx; }
.tag-primary  { background: #e6e9ff; color: var(--color-primary); }
.tag-success  { background: var(--color-success-bg); color: var(--color-success); }
.tag-warning  { background: var(--color-warning-bg); color: var(--color-warning); }
.tag-danger   { background: var(--color-danger-bg); color: var(--color-danger); }
.tag-sale     { background: linear-gradient(135deg, #667eea20, #764ba220); color: var(--color-primary); font-weight: 600; }
.tag-rental   { background: #fff2e8; color: var(--color-warning); font-weight: 600; }

/* ===== 卡片 ===== */
.card {
  background: var(--color-card); border-radius: var(--radius-lg);
  padding: 30rpx; box-shadow: var(--shadow-md);
}

/* ===== 分割线 ===== */
.divider { height: 1rpx; background: var(--color-border); margin: 20rpx 0; }

/* ===== 安全区域 ===== */
.safe-area-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx); }

/* ===== 加载中 ===== */
.loading { display: flex; align-items: center; justify-content: center; padding: 60rpx 0; color: var(--color-text-hint); font-size: var(--font-sm); }
.loading-spinner {
  width: 40rpx; height: 40rpx; border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary); border-radius: 50%;
  animation: spin 0.8s linear infinite; margin-right: 12rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 文字省略 ===== */
.ellipsis  { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

/* ===== 搜索框 focus 光晕 ===== */
.search-focus-ring {
  transition: box-shadow 0.25s;
}
.search-focus-ring:focus-within {
  box-shadow: 0 0 0 3rpx rgba(102,126,234,0.2), var(--shadow-md);
}

/* ===== 触摸反馈 ===== */
.tap-active:active { transform: scale(0.97); opacity: 0.85; transition: all 0.15s; }
