/* 首页样式 */
.page-container { min-height: 100vh; display: flex; flex-direction: column; }

/* ===== Hero ===== */
.hero-section {
  position: relative; margin: 24rpx; border-radius: var(--radius-lg); overflow: hidden;
}
.hero-bg {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: var(--color-gradient);
}
.hero-content {
  position: relative; z-index: 1; padding: 48rpx 36rpx 36rpx;
  display: flex; flex-direction: column; align-items: center;
}
.hero-title {
  font-size: 48rpx; font-weight: 700; color: #fff; letter-spacing: 4rpx; margin-bottom: 6rpx;
}
.hero-subtitle {
  font-size: var(--font-sm); color: rgba(255,255,255,0.7); margin-bottom: 28rpx;
}
.hero-search {
  width: 100%; display: flex; align-items: center;
  background: rgba(255,255,255,0.95); border-radius: var(--radius-round);
  padding: 18rpx 28rpx; box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
}
.search-icon-text { font-size: 32rpx; margin-right: 14rpx; opacity: 0.5; }
.hero-search .search-placeholder { color: #bbb; font-size: var(--font-md); }

/* ===== 快捷入口 ===== */
.quick-entry {
  display: flex; gap: 16rpx; margin: 0 24rpx 24rpx;
}
.entry-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  background: var(--color-card); border-radius: var(--radius-md);
  padding: 24rpx 8rpx; box-shadow: var(--shadow-sm);
}
.entry-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-bottom: 10rpx;
}
.entry-sale  { background: #e6e9ff; }
.entry-old   { background: #e6f7e6; }
.entry-rent  { background: #fff7e6; }
.entry-map   { background: #e6f4ff; }
.entry-text { font-size: var(--font-sm); color: var(--color-text-secondary); font-weight: 500; }

/* ===== Banner ===== */
.banner-container { margin: 0 24rpx 24rpx; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
.banner-swiper { width: 100%; height: 300rpx; }
.banner-image { width: 100%; height: 100%; }
.banner-tag {
  position: absolute; bottom: 20rpx; left: 20rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  padding: 6rpx 18rpx; border-radius: 20rpx; font-size: var(--font-xs);
}

/* ===== Section ===== */
.section { margin: 0 24rpx 24rpx; background: var(--color-card); border-radius: var(--radius-lg); padding: 28rpx 24rpx; box-shadow: var(--shadow-sm); }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title-wrap { display: flex; align-items: center; }
.section-dot { width: 8rpx; height: 26rpx; border-radius: 4rpx; background: var(--color-primary); margin-right: 12rpx; }
.section-dot.hot-dot  { background: var(--color-danger); }
.section-dot.news-dot { background: var(--color-warning); }
.section-title { font-size: var(--font-lg); font-weight: 600; color: var(--color-text-primary); }
.section-more { font-size: var(--font-sm); color: var(--color-text-hint); }

/* ===== 横向房源卡片 ===== */
.property-scroll { white-space: nowrap; }
.p-card-h {
  display: inline-block; width: 270rpx; background: var(--color-bg);
  border-radius: var(--radius-md); overflow: hidden; margin-right: 16rpx; vertical-align: top;
}
.p-card-h:last-child { margin-right: 0; }
.p-card-img { width: 100%; height: 180rpx; }
.p-card-body { padding: 16rpx 14rpx; }
.p-card-title { font-size: var(--font-sm); color: var(--color-text-primary); margin-bottom: 8rpx; line-height: 1.4; }
.p-card-tags { margin-bottom: 8rpx; }
.p-card-price { display: flex; align-items: baseline; color: var(--color-price); font-weight: 600; }
.price-num { font-size: var(--font-lg); }
.price-unit { font-size: var(--font-xs); margin-left: 2rpx; }

/* ===== 房源列表 ===== */
.property-list { padding-top: 4rpx; }
.p-item {
  display: flex; background: var(--color-bg); border-radius: var(--radius-md);
  padding: 20rpx; margin-bottom: 16rpx;
}
.p-item:last-child { margin-bottom: 0; }
.p-item-thumb { width: 200rpx; height: 150rpx; border-radius: var(--radius-sm); flex-shrink: 0; }
.p-item-content { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.p-item-title { font-size: var(--font-md); font-weight: 600; color: var(--color-text-primary); }
.p-item-meta { display: flex; gap: 16rpx; }
.meta-item { font-size: var(--font-sm); color: var(--color-text-secondary); }
.p-item-location { display: flex; align-items: center; }
.loc-icon { font-size: 20rpx; margin-right: 6rpx; }
.loc-text { font-size: var(--font-xs); color: var(--color-text-hint); }
.p-item-footer { display: flex; justify-content: space-between; align-items: center; }
.p-item-price { display: flex; align-items: baseline; color: var(--color-price); font-weight: 700; }
.p-item-unit { font-size: var(--font-xs); color: var(--color-text-hint); }

/* ===== 资讯列表 ===== */
.news-list { padding-top: 4rpx; }
.news-item {
  display: flex; padding: 20rpx; background: var(--color-bg);
  border-radius: var(--radius-md); margin-bottom: 16rpx;
}
.news-item:last-child { margin-bottom: 0; }
.news-thumb { width: 180rpx; height: 120rpx; border-radius: var(--radius-sm); margin-right: 20rpx; flex-shrink: 0; }
.news-content { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.news-content.no-thumb { margin-left: 0; }
.news-title { font-size: var(--font-md); color: var(--color-text-primary); line-height: 1.5; }
.news-meta { display: flex; align-items: center; }
.news-category {
  padding: 4rpx 14rpx; background: var(--color-gradient); color: #fff;
  border-radius: 20rpx; font-size: var(--font-xs); margin-right: 12rpx;
}
.news-time { font-size: var(--font-xs); color: var(--color-text-hint); }
/* Hero 底部行 */
.hero-bottom-row { width: 100%; }
.hero-bottom-row .hero-search { flex: 1; }

/* 对比横幅 */
.compare-banner {
  margin: 0 24rpx 16rpx; background: var(--color-card);
  border-radius: var(--radius-md); padding: 20rpx 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: var(--shadow-sm); border-left: 6rpx solid var(--color-primary);
  animation: fadeInUp 0.3s ease both;
}
.cb-left { display: flex; align-items: center; }
.cb-icon { font-size: 36rpx; margin-right: 14rpx; }
.cb-text { font-size: var(--font-sm); color: var(--color-text-secondary); }
.cb-num { color: var(--color-primary); font-weight: 700; font-size: var(--font-md); }
.cb-arrow { font-size: var(--font-lg); color: var(--color-text-hint); }