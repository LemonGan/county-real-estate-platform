/* 首页样式 - 修复版 */
.page-container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 搜索栏 - 修复蓝色背景问题 */
.search-bar {
  background: #fff;
  padding: 20rpx 30rpx;
}

.search-input {
  background: #f8f9fa;
  border-radius: 40rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.4;
}

/* 轮播图 */
.banner-container {
  margin: 20rpx 30rpx 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 快捷入口 */
.quick-entry {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20rpx;
  background: #fff;
  margin: 30rpx;
  border-radius: 24rpx;
  padding: 36rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
}

.entry-text {
  font-size: 24rpx;
  color: #333;
}

/* 区块通用样式 */
.section {
  margin: 0 30rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding-left: 20rpx;
  border-left: 6rpx solid #667eea;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 资讯列表 */
.news-list {
  background: transparent;
}

.news-item {
  display: flex;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.news-item:last-child {
  margin-bottom: 0;
}

.news-thumb {
  width: 180rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.news-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.news-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.news-meta {
  display: flex;
  align-items: center;
}

.news-category {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-right: 16rpx;
}

.news-time {
  font-size: 22rpx;
  color: #999;
}

/* 横向滚动房源卡片 */
.property-scroll {
  white-space: nowrap;
}

.property-card-horizontal {
  display: inline-block;
  width: 280rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  overflow: hidden;
  margin-right: 20rpx;
  vertical-align: top;
}

.property-card-horizontal:last-child {
  margin-right: 0;
}

.property-image {
  width: 100%;
  height: 180rpx;
}

.property-info {
  padding: 20rpx;
}

.property-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.property-tags {
  margin-bottom: 12rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.tag-primary {
  background: #e6e9ff;
  color: #667eea;
}

.tag-success {
  background: #e6f7e6;
  color: #52c41a;
}

.property-price {
  color: #ff4d4f;
  font-weight: 600;
}

.price-integer {
  font-size: 32rpx;
}

.price-unit {
  font-size: 22rpx;
}

/* 热门房源列表 */
.property-list {
  background: transparent;
}

.property-item {
  display: flex;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.property-item:last-child {
  margin-bottom: 0;
}

.property-thumb {
  width: 200rpx;
  height: 150rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.property-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.property-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.property-meta {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 0;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.property-location {
  display: flex;
  align-items: center;
}

.location-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 22rpx;
  color: #999;
}

.property-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.property-price {
  color: #ff4d4f;
}

.property-unitprice {
  font-size: 22rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-text {
  font-size: 26rpx;
  color: #667eea;
}

/* 加载状态 */
.loading {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
