/* 首页样式 */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 24rpx;
  margin: 20rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  margin-right: 16rpx;
}

.search-placeholder {
  color: #8c8c8c;
  font-size: 28rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 轮播图 */
.banner-container {
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 快捷入口 */
.quick-entry {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  background-color: #fff;
  padding: 32rpx 0;
  margin: 20rpx;
  border-radius: 16rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
  margin-bottom: 16rpx;
}

.entry-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
}

.entry-text {
  font-size: 24rpx;
  color: #333;
}

/* 视频横向滚动 */
.video-scroll {
  white-space: nowrap;
}

.video-card {
  display: inline-block;
  width: 260rpx;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 16rpx;
  vertical-align: top;
  position: relative;
}

.video-card:last-child {
  margin-right: 0;
}

.video-thumb {
  width: 100%;
  height: 180rpx;
  position: relative;
}

.video-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 4rpx;
}

.video-info {
  padding: 12rpx;
}

.video-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.video-stats {
  display: flex;
  align-items: center;
}

.stats-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.stats-text {
  font-size: 22rpx;
  color: #8c8c8c;
}

/* 资讯列表 */
.news-list {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.news-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.news-item:last-child {
  border-bottom: none;
}

.news-thumb {
  width: 180rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.news-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.news-content.no-thumb {
  padding-left: 0;
}

.news-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.news-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #8c8c8c;
}

.news-category {
  padding: 4rpx 12rpx;
  background-color: #e6e9ff;
  color: #667eea;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.news-time {
  flex: 1;
}

/* 区块 */
.section {
  margin: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #8c8c8c;
}

/* 横向滚动房源 */
.property-scroll {
  white-space: nowrap;
}

.property-card-horizontal {
  display: inline-block;
  width: 280rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 20rpx;
  vertical-align: top;
}

.property-card-horizontal:last-child {
  margin-right: 0;
}

.property-image {
  width: 100%;
  height: 200rpx;
}

.property-info {
  padding: 16rpx;
}

.property-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.property-tags {
  margin-bottom: 12rpx;
}

.property-tags .tag {
  margin-right: 8rpx;
}

.property-price {
  color: #ff4d4f;
  font-weight: bold;
}

/* 房源列表 */
.property-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.property-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.property-item:last-child {
  border-bottom: none;
}

.property-thumb {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.property-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.property-meta {
  display: flex;
  gap: 16rpx;
  margin: 12rpx 0;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.property-location {
  display: flex;
  align-items: center;
  margin: 8rpx 0;
}

.location-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 24rpx;
  color: #8c8c8c;
}

.property-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.property-unitprice {
  font-size: 24rpx;
  color: #8c8c8c;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-text {
  font-size: 28rpx;
  color: #1890ff;
}

/* 加载状态 */
.loading {
  padding: 40rpx 0;
  text-align: center;
  color: #8c8c8c;
}
