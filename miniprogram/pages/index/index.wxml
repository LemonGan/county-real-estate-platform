<!-- 首页 -->
<view class="page-container">
  <!-- 搜索栏 -->
  <view class="search-bar" bindtap="goToSearch">
    <view class="search-input">
      <text class="search-placeholder">搜索房源、小区、地址...</text>
    </view>
    <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit"></image>
  </view>

  <!-- 轮播图 -->
  <view class="banner-container" wx:if="{{banners.length > 0}}">
    <swiper class="banner-swiper" indicator-dots autoplay interval="3000" circular>
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <image class="banner-image" src="{{item.image}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-entry">
    <view class="entry-item" bindtap="goToList">
      <image class="entry-icon" src="/assets/icons/property.png" mode="aspectFit"></image>
      <text class="entry-text">找新房</text>
    </view>
    <view class="entry-item" bindtap="goToList">
      <image class="entry-icon" src="/assets/icons/old-property.png" mode="aspectFit"></image>
      <text class="entry-text">找二手房</text>
    </view>
    <view class="entry-item" bindtap="goToList">
      <image class="entry-icon" src="/assets/icons/rent.png" mode="aspectFit"></image>
      <text class="entry-text">租房</text>
    </view>
    <view class="entry-item" bindtap="goToMap">
      <image class="entry-icon" src="/assets/icons/map.png" mode="aspectFit"></image>
      <text class="entry-text">地图找房</text>
    </view>
    <view class="entry-item" bindtap="goToVideos">
      <image class="entry-icon" src="/assets/icons/video.png" mode="aspectFit"></image>
      <text class="entry-text">视频看房</text>
    </view>
  </view>

  <!-- 热门视频 -->
  <view class="section" wx:if="{{hotVideos.length > 0}}">
    <view class="section-header">
      <text class="section-title">热门视频</text>
      <text class="section-more" bindtap="goToVideos">更多 ></text>
    </view>

    <scroll-view class="video-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="video-card" wx:for="{{hotVideos}}" wx:key="id" bindtap="goToVideoDetail" data-id="{{item.id}}">
        <image class="video-thumb" src="{{item.cover_url}}" mode="aspectFill"></image>
        <view class="video-play-icon">
          <image class="play-icon" src="/assets/icons/play-white.png" mode="aspectFit"></image>
        </view>
        <view class="video-info">
          <view class="video-title ellipsis">{{item.title}}</view>
          <view class="video-stats">
            <image class="stats-icon" src="/assets/icons/play-gray.png" mode="aspectFit"></image>
            <text class="stats-text">{{item.play_count_text}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 房产资讯 -->
  <view class="section" wx:if="{{newsList.length > 0}}">
    <view class="section-header">
      <text class="section-title">房产资讯</text>
      <text class="section-more" bindtap="goToNews">更多 ></text>
    </view>

    <view class="news-list">
      <view class="news-item" wx:for="{{newsList}}" wx:key="id" bindtap="goToNewsDetail" data-id="{{item.id}}">
        <image class="news-thumb" src="{{item.cover_url}}" mode="aspectFill" wx:if="{{item.cover_url}}"></image>
        <view class="news-content {{item.cover_url ? '' : 'no-thumb'}}">
          <view class="news-title ellipsis-2">{{item.title}}</view>
          <view class="news-meta">
            <text class="news-category">{{item.category_name}}</text>
            <text class="news-time">{{item.publish_time_text}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐房源 -->
  <view class="section" wx:if="{{recommendProperties.length > 0}}">
    <view class="section-header">
      <text class="section-title">为您推荐</text>
      <text class="section-more" bindtap="goToList">更多 ></text>
    </view>

    <scroll-view class="property-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="property-card-horizontal" wx:for="{{recommendProperties}}" wx:key="id"
            bindtap="goToDetail" data-id="{{item.id}}">
        <image class="property-image" src="{{item.cover_image_url || '/assets/images/placeholder.png'}}"
               mode="aspectFill"></image>
        <view class="property-info">
          <view class="property-title ellipsis-2">{{item.title}}</view>
          <view class="property-tags">
            <text class="tag tag-primary" wx:if="{{item.property_type}}">{{item.property_type_text}}</text>
            <text class="tag tag-success" wx:if="{{item.transaction_type}}">{{item.transaction_type_text}}</text>
          </view>
          <view class="property-price">
            <text class="price-integer">{{item.total_price_text}}</text>
            <text class="price-unit">万</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 热门房源 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">热门房源</text>
      <text class="section-more" bindtap="goToList">更多 ></text>
    </view>

    <view class="property-list">
      <view class="property-item" wx:for="{{hotProperties}}" wx:key="id"
            bindtap="goToDetail" data-id="{{item.id}}">
        <image class="property-thumb" src="{{item.cover_image_url || '/assets/images/placeholder.png'}}"
               mode="aspectFill"></image>
        <view class="property-content">
          <view class="property-title ellipsis">{{item.title}}</view>
          <view class="property-meta">
            <text class="meta-item">{{item.area_text}}</text>
            <text class="meta-item" wx:if="{{item.room_type}}">{{item.room_type}}</text>
          </view>
          <view class="property-location" wx:if="{{item.city && item.district}}">
            <image class="location-icon" src="/assets/icons/location.png" mode="aspectFit"></image>
            <text class="location-text">{{item.city}} {{item.district}}</text>
          </view>
          <view class="property-footer">
            <view class="property-price">
              <text class="price-integer">{{item.total_price_text}}</text>
              <text class="price-unit">万</text>
            </view>
            <text class="property-unitprice" wx:if="{{item.unit_price}}">{{item.unit_price}}元/㎡</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore && hotProperties.length > 0}}" bindtap="loadMore">
      <text class="load-more-text">加载更多</text>
    </view>

    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>
