/* pages/video/list/list.wxss */
.video-page {
  width: 100%;
  height: 100vh;
  background-color: #000;
  position: relative;
}

/* 标签栏 */
.tabs-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), transparent);
}

.tabs {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}

.tab-item {
  padding: 12rpx 32rpx;
  margin: 0 16rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  border-radius: 32rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #667eea;
  color: #fff;
  font-weight: bold;
}

/* 视频列表 */
.video-swiper {
  width: 100%;
  height: 100%;
}

.video-item {
  width: 100%;
  height: 100%;
}

.video-container {
  width: 100%;
  height: 100%;
  position: relative;
  background-color: #000;
}

/* 视频播放器 */
.video-player {
  width: 100%;
  height: 100%;
}

/* 右侧操作栏 */
.action-bar {
  position: absolute;
  right: 20rpx;
  bottom: 280rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
  position: relative;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  margin-bottom: 8rpx;
}

.follow-btn {
  position: absolute;
  bottom: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.3));
}

.action-count {
  font-size: 22rpx;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* 底部信息 */
.video-info {
  position: absolute;
  left: 20rpx;
  right: 100rpx;
  bottom: 80rpx;
  z-index: 10;
}

.info-top {
  margin-bottom: 20rpx;
}

.agent-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.video-title {
  font-size: 26rpx;
  color: #fff;
  line-height: 1.5;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 关联房源卡片 */
.property-card {
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 12rpx;
  padding: 16rpx;
  backdrop-filter: blur(10px);
}

.property-thumb {
  width: 120rpx;
  height: 90rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.property-info {
  flex: 1;
  min-width: 0;
}

.property-title {
  font-size: 24rpx;
  color: #fff;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.property-price {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.price-unit {
  font-size: 20rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

/* 空状态 */
.empty-state {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 加载状态 */
.loading-state {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000;
  z-index: 200;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}
