<!--pages/video/list/list.wxml-->
<view class="video-page">
  <!-- 标签栏 -->
  <view class="tabs-wrapper">
    <view class="tabs">
      <view
        class="tab-item {{currentTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="switchTab"
      >
        {{item}}
      </view>
    </view>
  </view>

  <!-- 视频列表 -->
  <swiper
    class="video-swiper"
    current="{{currentVideoIndex}}"
    vertical="true"
    circular="true"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{videoList}}" wx:key="id" class="video-item">
      <view class="video-container">
        <!-- 视频播放器 -->
        <video
          id="video-{{item.id}}"
          class="video-player"
          src="{{item.video_url}}"
          poster="{{item.cover_url}}"
          controls="{{true}}"
          autoplay="{{currentVideoId === item.id}}"
          loop="{{false}}"
          muted="{{false}}"
          show-center-play-btn="{{true}}"
          show-play-btn="{{true}}"
          enable-play-gesture="{{true}}"
          object-fit="contain"
          bindplay="onPlayVideo"
          data-id="{{item.id}}"
          bindpause="onPauseVideo"
          bindended="onVideoEnd"
        />

        <!-- 右侧操作栏 -->
        <view class="action-bar">
          <!-- 头像 -->
          <view class="action-item" bindtap="goToAgent" data-agent-id="{{item.agent_id}}">
            <image class="avatar" src="{{item.agent_avatar || '/assets/images/default-avatar.png'}}" />
            <view class="follow-btn" wx:if="{{!item.is_followed}}">+</view>
          </view>

          <!-- 点赞 -->
          <view class="action-item" bindtap="onLike" data-id="{{item.id}}" data-index="{{index}}">
            <image class="action-icon" src="{{item.is_liked ? '/assets/icons/heart-filled.png' : '/assets/icons/heart.png'}}" />
            <text class="action-count">{{item.like_count > 999 ? '999+' : item.like_count}}</text>
          </view>

          <!-- 评论 -->
          <view class="action-item" bindtap="goToVideoDetail" data-id="{{item.id}}">
            <image class="action-icon" src="/assets/icons/comment.png" />
            <text class="action-count">{{item.comment_count > 999 ? '999+' : item.comment_count}}</text>
          </view>

          <!-- 收藏 -->
          <view class="action-item" bindtap="onFavorite" data-id="{{item.id}}" data-index="{{index}}">
            <image class="action-icon" src="{{item.is_favorited ? '/assets/icons/star-filled.png' : '/assets/icons/star.png'}}" />
            <text class="action-count">{{item.favorite_count > 999 ? '999+' : item.favorite_count}}</text>
          </view>

          <!-- 分享 -->
          <view class="action-item" bindtap="onShare" data-id="{{item.id}}" data-title="{{item.title}}" data-cover="{{item.cover_url}}">
            <image class="action-icon" src="/assets/icons/share.png" />
            <text class="action-count">分享</text>
          </view>
        </view>

        <!-- 底部信息 -->
        <view class="video-info">
          <view class="info-top">
            <view class="agent-name">@{{item.agent_name}}</view>
            <view class="video-title">{{item.title}}</view>
          </view>

          <!-- 关联房源信息 -->
          <view class="property-card" wx:if="{{item.property}}" bindtap="goToProperty" data-id="{{item.property.id}}">
            <image class="property-thumb" src="{{item.property.cover_url}}" />
            <view class="property-info">
              <view class="property-title">{{item.property.title}}</view>
              <view class="property-price">
                <text class="price-value">{{item.property.price}}</text>
                <text class="price-unit">万</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{videoList.length === 0 && !loading}}">
    <image class="empty-icon" src="/assets/icons/empty-video.png" />
    <view class="empty-text">暂无视频内容</view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>
</view>
