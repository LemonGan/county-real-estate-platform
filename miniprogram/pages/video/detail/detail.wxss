/* pages/video/detail/detail.wxss */
.video-detail-page {
  min-height: 100vh;
  background-color: #000;
  padding-bottom: 120rpx;
}

/* 视频播放器 */
.video-player-wrapper {
  width: 100%;
  padding-top: 56.25%; /* 16:9 比例 */
  position: relative;
  background-color: #000;
}

.video-player {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 视频信息区域 */
.video-info-section {
  background-color: #1a1a1a;
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.info-main {
  margin-bottom: 24rpx;
}

.video-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.video-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-right: 24rpx;
}

/* 作者信息 */
.author-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.author-detail {
  flex: 1;
  min-width: 0;
}

.author-name {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.author-stats {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.follow-btn {
  padding: 12rpx 32rpx;
  background-color: #667eea;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: none;
}

.follow-btn.following {
  background-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
}

.follow-btn::after {
  border: none;
}

/* 操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 48rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.share-button {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.share-button::after {
  border: none;
}

/* 关联房源 */
.property-section {
  background-color: #1a1a1a;
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.property-card {
  display: flex;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  overflow: hidden;
}

.property-image {
  width: 200rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.property-info {
  flex: 1;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.property-title {
  font-size: 28rpx;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.property-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.property-price {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.price-unit {
  font-size: 20rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

/* 评论区 */
.comments-section {
  background-color: #1a1a1a;
  padding: 24rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.comments-list {
  max-height: 800rpx;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-content-wrapper {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-user {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 16rpx;
}

.comment-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.comment-text {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.5;
}

/* 回复 */
.comment-replies {
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-top: 12rpx;
}

.reply-item {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-user {
  color: #667eea;
  margin-right: 8rpx;
}

.reply-text {
  color: rgba(255, 255, 255, 0.7);
}

/* 评论操作 */
.comment-actions {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.action-icon-sm {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

.action-text-sm {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.text-danger {
  color: #ff4d4f;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.load-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 空状态 */
.empty-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 评论输入框 */
.comment-input-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.comment-input-wrapper {
  background-color: #2a2a2a;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 16rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.reply-to {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.close-icon {
  width: 32rpx;
  height: 32rpx;
}

.input-row {
  display: flex;
  align-items: center;
}

.comment-input {
  flex: 1;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #fff;
}

.send-btn {
  margin-left: 16rpx;
  padding: 12rpx 32rpx;
  background-color: #667eea;
  color: #fff;
  font-size: 26rpx;
  border-radius: 24rpx;
  border: none;
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  background-color: rgba(102, 126, 234, 0.5);
}

/* 加载页面 */
.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #000;
}

.loading-page .loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #667eea;
}
