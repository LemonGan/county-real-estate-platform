/* pages/news/detail/detail.wxss */
.news-detail-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 加载容器 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #fff;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(102, 126, 234, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 资讯详情 */
.news-detail {
  background-color: #fff;
}

/* 封面图 */
.news-cover {
  width: 100%;
  height: 400rpx;
}

/* 文章头部 */
.article-header {
  padding: 32rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.author-name {
  font-size: 26rpx;
  color: #333;
}

.article-time {
  font-size: 22rpx;
  color: #999;
}

.view-count {
  font-size: 22rpx;
  color: #999;
}

/* 文章内容 */
.article-content {
  padding: 32rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.article-content img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 24rpx 0;
  border-radius: 8rpx;
}

.article-content p {
  margin-bottom: 24rpx;
}

.article-content h3 {
  font-size: 34rpx;
  font-weight: bold;
  margin: 32rpx 0 16rpx;
  color: #333;
}

/* 文章底部 */
.article-footer {
  padding: 32rpx;
  border-top: 1rpx solid #e8e8e8;
}

.footer-stats {
  display: flex;
  gap: 48rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  width: 32rpx;
  height: 32rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #999;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  border: none;
}

.action-btn::after {
  border: none;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 底部导航栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #fff;
  border-top: 1rpx solid #e8e8e8;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 32rpx;
  font-size: 22rpx;
  color: #333;
  background: transparent;
  border: none;
  line-height: 1.4;
}

.bar-item::after {
  border: none;
}

.share-btn {
  padding: 0;
  margin: 0;
}

.bar-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.bar-text {
  font-size: 22rpx;
  color: #333;
}
