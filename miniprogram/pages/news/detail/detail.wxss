/* 资讯详情页面样式 - 阅读型卡片布局 */
.news-detail-page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: 136rpx;
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e7ecef;
  border-top-color: #0f6f5f;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.news-detail {
  padding-bottom: 24rpx;
}

.news-cover {
  width: 100%;
  height: 420rpx;
  background: #e8edf2;
}

.article-header,
.article-content {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.05);
}

.article-category {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(31, 138, 112, 0.12);
  color: #0f6f5f;
  font-size: 20rpx;
  font-weight: 600;
}

.article-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #122033;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef3f6;
}

.author-block {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.article-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b94a6;
}

.meta-right {
  flex-shrink: 0;
}

.view-count {
  color: #6b7280;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f3f7f9;
  color: #52606d;
  font-size: 22rpx;
}

.article-richtext {
  font-size: 30rpx;
  color: #243042;
  line-height: 1.9;
}

.article-richtext p {
  margin: 0 0 20rpx;
}

.article-richtext img {
  max-width: 100%;
  border-radius: 18rpx;
}

.article-footer {
  margin: 20rpx 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.05);
}

.footer-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #52606d;
  font-size: 24rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #0f6f5f 0%, #1f8a70 100%);
  color: #fff;
  font-size: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(15, 111, 95, 0.18);
}

.action-btn::after,
.share-btn::after {
  border: none;
}

.btn-icon {
  width: 34rpx;
  height: 34rpx;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  gap: 16rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 32rpx rgba(15, 23, 42, 0.12);
  backdrop-filter: blur(16rpx);
}

.bar-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #f4f7f8;
  color: #334155;
  font-size: 26rpx;
}

.bar-icon {
  width: 30rpx;
  height: 30rpx;
}

.share-btn {
  background: linear-gradient(135deg, #0f6f5f 0%, #1f8a70 100%);
  color: #fff;
}

.detail-empty {
  margin: 160rpx 36rpx 0;
  padding: 56rpx 36rpx;
  border-radius: 28rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.05);
}

.detail-empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: .76;
}

.detail-empty-title {
  margin-top: 24rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
}

.detail-empty-desc {
  margin-top: 12rpx;
  color: #8b94a6;
  font-size: 24rpx;
  line-height: 1.6;
}

.detail-empty-btn {
  width: 260rpx;
  height: 76rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: #0f6f5f;
  color: #fff;
  font-size: 26rpx;
}

.detail-empty-btn::after {
  border: none;
}
