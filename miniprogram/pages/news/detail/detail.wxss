/* 资讯详情页面样式 - 现代风格 */
.news-detail-page {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 封面图 */
.news-cover {
  width: 100%;
  height: 400rpx;
}

/* 文章头部 */
.article-header {
  background: #fff;
  padding: 36rpx;
}

.article-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.article-meta {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.author-name {
  font-size: 26rpx;
  color: #333;
  margin-right: 20rpx;
}

.article-time {
  font-size: 24rpx;
  color: #999;
}

/* 文章内容 */
.article-content {
  background: #fff;
  margin-top: 20rpx;
  padding: 36rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

/* 相关推荐 */
.recommend-section {
  background: #fff;
  margin-top: 20rpx;
  padding: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.recommend-list {
  display: flex;
  flex-direction: column;
}

.recommend-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.recommend-item:last-child {
  border-bottom: none;
}

.recommend-thumb {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.recommend-info {
  flex: 1;
}

.recommend-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 底部占位 */
.bottom-space {
  height: 120rpx;
}
