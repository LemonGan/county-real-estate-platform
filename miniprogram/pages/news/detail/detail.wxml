<!--pages/news/detail/detail.wxml-->
<view class="news-detail-page">
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>

  <view class="news-detail" wx:if="{{!loading && news}}">
    <image class="news-cover" src="{{news.cover_url}}" mode="aspectFill" />

    <view class="article-header">
      <view class="article-category">{{news.category_name}}</view>
      <view class="article-title">{{news.title}}</view>
      <view class="article-meta">
        <view class="meta-left">
          <image class="author-avatar" src="{{news.author_avatar || '/assets/images/default-avatar.png'}}" />
          <view class="author-block">
            <text class="author-name">{{news.author}}</text>
            <text class="article-time">{{news.publish_time_text || news.publish_time}}</text>
          </view>
        </view>
        <view class="meta-right">
          <text class="view-count">{{news.view_count}}阅读</text>
        </view>
      </view>
      <view class="tag-row" wx:if="{{news.tags && news.tags.length}}">
        <text class="tag-item" wx:for="{{news.tags}}" wx:key="*this">#{{item}}</text>
      </view>
    </view>

    <view class="article-content">
      <rich-text nodes="{{news.content}}" class="article-richtext"></rich-text>
    </view>

    <view class="article-footer">
      <view class="footer-stats">
        <view class="stat-item">
          <text class="stat-icon">👁️</text>
          <text class="stat-text">{{news.view_count}}</text>
        </view>
        <view class="stat-item" bindtap="likeNews">
          <text class="stat-icon">{{isLiked ? '❤️' : '🤍'}}</text>
          <text class="stat-text">{{news.like_count}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">⭐</text>
          <text class="stat-text">{{news.collect_count}}</text>
        </view>
      </view>
      <view class="footer-actions">
        <button class="action-btn" open-type="share">
          <image class="btn-icon" src="/assets/icons/share.png" />
          <text>分享</text>
        </button>
        <button class="action-btn" bindtap="collectNews">
          <image class="btn-icon" src="{{isCollected ? '/assets/icons/favorite.png' : '/assets/icons/favorites.png'}}" />
          <text>{{isCollected ? '已收藏' : '收藏'}}</text>
        </button>
      </view>
    </view>
  </view>

  <view class="bottom-bar" wx:if="{{!loading}}">
    <view class="bar-item" bindtap="goHome">
      <image class="bar-icon" src="/assets/icons/home.png" />
      <text class="bar-text">首页</text>
    </view>
    <button class="bar-item share-btn" open-type="share">
      <image class="bar-icon" src="/assets/icons/share.png" />
      <text class="bar-text">分享</text>
    </button>
  </view>
</view>
