<!--pages/news/list/list.wxml-->
<view class="news-page">
  <!-- 分类标签 -->
  <view class="category-tabs">
    <scroll-view class="tabs-scroll" scroll-x="{{true}}">
      <view
        class="tab-item {{currentCategory === item.value ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="switchCategory"
      >
        {{item.label}}
      </view>
    </scroll-view>
  </view>

  <!-- 资讯列表 -->
  <view class="news-list">
    <view
      class="news-item"
      wx:for="{{newsList}}"
      wx:key="id"
      bindtap="goToNewsDetail"
      data-id="{{item.id}}"
    >
      <image class="news-thumb" src="{{item.cover_url}}" mode="aspectFill" />
      <view class="news-content">
        <view class="news-title ellipsis-2">{{item.title}}</view>
        <view class="news-summary ellipsis">{{item.summary}}</view>
        <view class="news-meta">
          <view class="meta-left">
            <text class="news-category">{{item.category_name}}</text>
            <text class="news-author">{{item.author}}</text>
          </view>
          <text class="news-time">{{item.publish_time}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{newsList.length === 0 && !loading}}">
    <image class="empty-icon" src="/assets/icons/empty-news.png" />
    <view class="empty-text">暂无资讯</view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && newsList.length > 0 && !loading}}">
    <text class="load-more-text">上拉加载更多</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && newsList.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>
