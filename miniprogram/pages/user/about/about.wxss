/* 关于我们样式 */
.about-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.app-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background-color: #fff;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.app-version {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 简介 */
.intro-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 特色功能 */
.features-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 32rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.5;
}

/* 联系方式 */
.contacts-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.contact-list {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
}

.contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
}

.contact-copy {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 底部按钮 */
.bottom-actions {
  padding: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  background-color: #667eea;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.action-btn::after {
  border: none;
}

/* 版权信息 */
.copyright {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.copyright-text {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-bottom: 8rpx;
}
