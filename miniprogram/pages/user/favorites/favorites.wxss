/* 我的收藏样式 */
.favorites-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 收藏列表 */
.favorites-list {
  padding: 20rpx;
}

.favorite-item {
  display: flex;
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.property-image {
  width: 240rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.property-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.property-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.property-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.property-tags .tag {
  padding: 6rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: #666;
}

.property-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.property-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
  margin-right: 4rpx;
}

.property-price .unit {
  font-size: 24rpx;
  color: #999;
}

.favorite-time {
  font-size: 22rpx;
  color: #8c8c8c;
}

/* 取消收藏按钮 */
.remove-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
}

.remove-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 32rpx;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #8c8c8c;
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 280rpx;
  height: 80rpx;
  background-color: #667eea;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}
