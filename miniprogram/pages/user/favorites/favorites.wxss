/* 我的收藏页 */
.favorites-container { min-height: 100vh; }

/* 加载 */
.loading-container {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 200rpx 0;
}
.loading-spinner {
  width: 48rpx; height: 48rpx; border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary); border-radius: 50%;
  animation: spin 0.8s linear infinite; margin-bottom: 16rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: var(--font-sm); color: var(--color-text-hint); }

/* 列表 */
.favorites-list { padding: 16rpx 24rpx; }
.favorite-item {
  display: flex; background: var(--color-card); border-radius: var(--radius-md);
  overflow: hidden; margin-bottom: 20rpx; box-shadow: var(--shadow-sm);
  animation: fadeInUp 0.3s ease both;
}
.property-image { width: 220rpx; height: 160rpx; flex-shrink: 0; }
.property-info { flex: 1; padding: 18rpx 16rpx; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.property-title { font-size: var(--font-md); font-weight: 600; color: var(--color-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 6rpx; }
.property-tags { display: flex; gap: 10rpx; }
.property-tags .tag { padding: 4rpx 12rpx; background: var(--color-bg); border-radius: 6rpx; font-size: var(--font-xs); color: var(--color-text-secondary); }
.property-price { display: flex; align-items: baseline; color: var(--color-price); font-weight: 700; }
.property-price .price { font-size: var(--font-lg); }
.property-price .unit { font-size: var(--font-xs); margin-left: 4rpx; color: var(--color-text-hint); }
.favorite-time { font-size: var(--font-xs); color: var(--color-text-hint); }
.remove-btn { padding: 16rpx 20rpx; display: flex; align-items: flex-start; justify-content: center; }
.remove-icon { width: 36rpx; height: 36rpx; opacity: 0.3; }

/* 空状态 */
.empty-container { display: flex; flex-direction: column; align-items: center; padding: 160rpx 40rpx; }
.empty-icon { width: 200rpx; height: 200rpx; margin-bottom: 30rpx; }
.empty-text { font-size: var(--font-lg); color: var(--color-text-hint); font-weight: 500; }
.empty-tip { font-size: var(--font-sm); color: #ccc; margin-top: 8rpx; }
.empty-btn {
  margin-top: 32rpx; padding: 16rpx 56rpx; background: var(--color-primary);
  color: #fff; border-radius: var(--radius-round); font-size: var(--font-md); border: none;
}
