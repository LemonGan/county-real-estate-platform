/* 用户收藏页面样式 */
.page-container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 导航栏 */
.navbar {
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 列表样式 */
.favorites-list {
  padding: 30rpx;
}

.favorite-item {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.property-image {
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.property-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.property-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.property-meta {
  font-size: 24rpx;
  color: #666;
}

.property-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.remove-btn {
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
}
