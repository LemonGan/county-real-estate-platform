.page { min-height: 100vh; padding: 28rpx 24rpx; box-sizing: border-box; background: #f5f7fb; }
.card { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; margin-bottom: 20rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 8rpx 30rpx rgba(27, 45, 76, 0.05); }
.label { color: #1f2937; font-size: 30rpx; font-weight: 600; }
.avatar-wrap { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #eef2f7; }
.change-text { color: #526edb; font-size: 26rpx; }
.nickname-input { flex: 1; margin-left: 36rpx; text-align: right; font-size: 30rpx; color: #111827; }
.hint { display: block; padding: 8rpx 12rpx; color: #8a94a6; font-size: 24rpx; line-height: 1.7; }
.save-btn { margin-top: 52rpx; border-radius: 14rpx; background: linear-gradient(135deg, #536dfe, #7656d8); color: #fff; font-size: 32rpx; }
.loading { padding-top: 180rpx; text-align: center; color: #94a3b8; }
