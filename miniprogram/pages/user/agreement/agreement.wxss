.page { min-height: 100vh; padding: 40rpx 28rpx 72rpx; box-sizing: border-box; background: #f6f8f7; color: #243a31; }
.hero { padding: 8rpx 8rpx 32rpx; }.eyebrow { display:block; color:#168264; font-size:20rpx; font-weight:700; letter-spacing:3rpx; }.title { display:block; margin-top:12rpx; font-size:50rpx; font-weight:700; letter-spacing:-2rpx; }.subtitle { display:block; margin-top:10rpx; color:#82928b; font-size:25rpx; }
.draft-notice { margin-bottom:22rpx; padding:22rpx; border:1rpx solid #f1d68b; border-radius:18rpx; background:#fff9ea; color:#7f6418; font-size:24rpx; line-height:1.65; }.notice-title { display:block; margin-bottom:6rpx; color:#9a7110; font-weight:650; }
.card { overflow:hidden; border:1rpx solid #e1e9e4; border-radius:22rpx; background:#fff; box-shadow:0 8rpx 25rpx rgba(24,60,46,.035); }.section { padding:28rpx; }.section + .section { border-top:1rpx solid #edf1ef; }.section-title { display:block; margin-bottom:13rpx; color:#29433a; font-size:29rpx; font-weight:650; }.paragraph { color:#60736a; font-size:25rpx; line-height:1.8; }
