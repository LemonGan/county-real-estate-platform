.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f5f7fb; }
.history-item { display: flex; gap: 20rpx; padding: 20rpx; margin-bottom: 18rpx; background: #fff; border-radius: 18rpx; box-shadow: 0 8rpx 28rpx rgba(32, 48, 82, .05); }
.cover { width: 190rpx; height: 142rpx; flex: none; border-radius: 12rpx; background: #eef2f7; }
.content { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.title { overflow: hidden; color: #1f2937; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.meta, .address { margin-top: 10rpx; color: #7b8799; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.footer { display: flex; align-items: baseline; justify-content: space-between; margin-top: auto; }
.price { color: #e7673f; font-size: 30rpx; font-weight: 700; }
.time { color: #a0a9b8; font-size: 22rpx; }
.loading, .more { padding: 40rpx; color: #94a3b8; font-size: 26rpx; text-align: center; }
.empty { display: flex; flex-direction: column; align-items: center; padding-top: 180rpx; }
.empty-image { width: 220rpx; height: 180rpx; }
.empty-title { margin-top: 22rpx; color: #475569; font-size: 32rpx; font-weight: 600; }
.empty-tip { margin-top: 12rpx; color: #94a3b8; font-size: 26rpx; }
.go-btn { width: 260rpx; margin-top: 40rpx; border-radius: 14rpx; background: #566de8; color: #fff; font-size: 30rpx; }
