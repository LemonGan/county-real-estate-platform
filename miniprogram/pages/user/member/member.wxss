/* 会员中心样式 */
page {
  background-color: #f5f5f5;
}

.container {
  min-height: 100vh;
}

.member-header {
  position: relative;
  height: 300rpx;
  overflow: hidden;
}

.member-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.member-info {
  position: relative;
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  margin-right: 24rpx;
}

.info-text {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.member-tag {
  font-size: 24rpx;
  color: #ffd700;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.member-tag.normal {
  color: #fff;
  background: rgba(255,255,255,0.15);
}

.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.privilege-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.privilege-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.privilege-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
}

.privilege-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.privilege-desc {
  font-size: 24rpx;
  color: #667eea;
}

.vip-cards {
  display: flex;
  gap: 20rpx;
}

.vip-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  position: relative;
}

.vip-card .vip-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 16rpx 0 8rpx;
}

.vip-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  margin-bottom: 12rpx;
}

.vip-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffd700;
  margin-bottom: 8rpx;
}

.vip-days {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.exchange-box {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.exchange-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.exchange-btn {
  width: 140rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exchange-tips {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
