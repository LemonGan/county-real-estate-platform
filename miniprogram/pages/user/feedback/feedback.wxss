.page { min-height: 100vh; padding: 40rpx 28rpx 72rpx; background: #f6f8f7; color: #1f352d; box-sizing: border-box; }
.intro { padding: 10rpx 8rpx 38rpx; }.eyebrow { display: block; color: #168264; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }.title { display: block; margin-top: 12rpx; font-size: 52rpx; font-weight: 700; letter-spacing: -2rpx; }.subtitle { display: block; margin-top: 12rpx; color: #7d8d86; font-size: 26rpx; }
.form-card, .history-card { border: 1rpx solid #e2e9e5; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(25, 65, 50, .04); }.form-card { padding: 30rpx; }.field-label { display: block; margin: 0 0 18rpx; color: #314b41; font-size: 26rpx; font-weight: 600; }.optional { color: #98a59f; font-size: 22rpx; font-weight: 400; }
.category-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 34rpx; }.category { padding: 14rpx 18rpx; border: 1rpx solid #dfe8e3; border-radius: 12rpx; color: #61746b; font-size: 24rpx; }.category.active { border-color: #168264; background: #e9f8f0; color: #087353; font-weight: 600; }
.content-input, .contact-input { width: 100%; border: 1rpx solid #dce6e1; border-radius: 14rpx; box-sizing: border-box; color: #20382f; font-size: 27rpx; }.content-input { height: 210rpx; padding: 20rpx; }.contact-input { height: 82rpx; padding: 0 20rpx; }.placeholder { color: #a5b0ab; }.count { margin: 10rpx 0 32rpx; color: #9aa8a1; text-align: right; font-size: 22rpx; }
.submit-button { width: 100%; margin-top: 34rpx; border-radius: 14rpx; background: #087353; color: #fff; font-size: 29rpx; font-weight: 600; }.submit-button[disabled] { opacity: .65; }
.history-head { display: flex; align-items: center; justify-content: space-between; margin: 46rpx 4rpx 20rpx; }.history-title { display: block; font-size: 31rpx; font-weight: 650; }.history-subtitle { display: block; margin-top: 5rpx; color: #8a9993; font-size: 22rpx; }.history-count { padding: 7rpx 13rpx; border-radius: 30rpx; background: #e8f5ee; color: #43806a; font-size: 22rpx; }
.history-card { overflow: hidden; }.feedback-item { padding: 26rpx 28rpx; }.feedback-item + .feedback-item { border-top: 1rpx solid #edf1ef; }.feedback-top { display: flex; justify-content: space-between; align-items: center; }.feedback-category { color: #5f746a; font-size: 23rpx; }.status { padding: 5rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; }.status-pending { background: #fff3d9; color: #a66800; }.status-processing { background: #e7f2ff; color: #2167a9; }.status-resolved { background: #e6f7ed; color: #137348; }.status-closed { background: #edf0ef; color: #6f7c75; }
.feedback-content { display: block; margin-top: 15rpx; color: #283c33; font-size: 27rpx; line-height: 1.65; }.feedback-time { display: block; margin-top: 12rpx; color: #9ba8a2; font-size: 21rpx; }.response { margin-top: 18rpx; padding: 16rpx; border-radius: 10rpx; background: #f2f8f5; }.response-label { display: block; color: #41816b; font-size: 21rpx; }.response-content { display: block; margin-top: 5rpx; color: #486057; font-size: 24rpx; line-height: 1.55; }.history-empty { padding: 52rpx 0; color: #a0aca7; text-align: center; font-size: 25rpx; }

.login-card { padding: 44rpx 30rpx; border: 1rpx solid #e2e9e5; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(25, 65, 50, .04); text-align: center; }
.login-title { display: block; color: #20382f; font-size: 31rpx; font-weight: 650; }
.login-desc { display: block; margin-top: 12rpx; color: #7d8d86; font-size: 24rpx; line-height: 1.55; }
.login-button { width: 260rpx; height: 76rpx; margin-top: 30rpx; border-radius: 999rpx; background: #087353; color: #fff; font-size: 27rpx; }
.login-button::after { border: none; }
