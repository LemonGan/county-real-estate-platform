/* 用户中心样式 */
.profile-container { min-height: 100vh; background-color: var(--color-bg); }
.user-card { background: var(--color-gradient); padding: 60rpx 40rpx 120rpx; }
.user-info { display: flex; align-items: center; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 6rpx solid rgba(255,255,255,0.3); box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.15); }
.user-detail { flex: 1; margin-left: 30rpx; }
.user-name { font-size: var(--font-xl); font-weight: 600; color: #fff; }
.user-phone { font-size: var(--font-sm); color: rgba(255,255,255,0.8); margin-top: 8rpx; }
.edit-icon { width: 40rpx; height: 40rpx; opacity: 0.7; }

/* 未登录 */
.login-card { background: var(--color-gradient); padding: 80rpx 40rpx 140rpx; display: flex; flex-direction: column; align-items: center; }
.login-avatar { width: 140rpx; height: 140rpx; border-radius: 50%; border: 6rpx solid rgba(255,255,255,0.3); margin-bottom: 30rpx; }
.login-tip { font-size: var(--font-md); color: rgba(255,255,255,0.8); margin-bottom: 30rpx; }
.login-btn { background: #fff; color: var(--color-primary); font-weight: 500; }

/* 统计卡片 */
.stats-card { display: flex; align-items: center; margin: -60rpx 30rpx 30rpx; background: var(--color-card); border-radius: var(--radius-lg); padding: 40rpx; box-shadow: var(--shadow-lg); }
.stat-item { flex: 1; text-align: center; }
.stat-value { display: block; font-size: var(--font-xxl); font-weight: 700; color: var(--color-text-primary); }
.stat-label { display: block; font-size: var(--font-sm); color: var(--color-text-hint); margin-top: 8rpx; }
.stat-divider { width: 1rpx; height: 60rpx; background: var(--color-border); }

/* 菜单 */
.menu-section { margin: 30rpx; background: var(--color-card); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
.menu-item { display: flex; align-items: center; padding: 32rpx; border-bottom: 1rpx solid var(--color-border); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { width: 44rpx; height: 44rpx; margin-right: 24rpx; }
.menu-title { flex: 1; font-size: var(--font-lg); color: var(--color-text-primary); }
.menu-badge { min-width: 34rpx; height: 34rpx; padding: 0 8rpx; margin-right: 16rpx; border-radius: 24rpx; background: var(--color-danger); color: #fff; font-size: 20rpx; line-height: 34rpx; text-align: center; box-sizing: border-box; }
.menu-arrow { width: 32rpx; height: 32rpx; opacity: 0.3; }

/* 退出 */
.logout-btn { margin: 40rpx 30rpx; background: var(--color-card); border-radius: var(--radius-lg); padding: 32rpx; text-align: center; box-shadow: var(--shadow-sm); font-size: var(--font-lg); color: var(--color-danger); }

/* 版本 */
.version-info { text-align: center; padding: 40rpx; }
.version-text { font-size: var(--font-xs); color: #ccc; }
