.messages-page { min-height: 100vh; background: var(--color-bg); }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 30rpx 18rpx; }
.summary { display: flex; align-items: baseline; gap: 14rpx; }
.summary-title { font-size: 36rpx; font-weight: 700; color: var(--color-text-primary); }
.summary-count { font-size: 24rpx; color: var(--color-primary); }
.summary-count.muted { color: var(--color-text-hint); }
.read-all { padding: 12rpx 0 12rpx 22rpx; font-size: 26rpx; color: var(--color-primary); }
.read-all.disabled { color: #b9bfd4; }
.loading-container { min-height: 480rpx; display: flex; flex-direction: column; gap: 20rpx; align-items: center; justify-content: center; color: var(--color-text-hint); font-size: 26rpx; }
.loading-spinner { width: 46rpx; height: 46rpx; border: 4rpx solid #e5e8f5; border-top-color: var(--color-primary); border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.message-list { padding: 0 24rpx 28rpx; }
.message-card { display: flex; padding: 28rpx 24rpx; margin-bottom: 18rpx; border-radius: 22rpx; background: #fff; box-shadow: var(--shadow-sm); animation: fadeInUp .28s ease both; }
.message-card.is-unread { box-shadow: 0 8rpx 26rpx rgba(102,126,234,.12); }
.message-card.is-read { opacity: .72; }
.message-icon { flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 600; }
.type-system { background: #eef0ff; color: #5d6fdb; }
.type-appointment { background: #fff2e8; color: #e7822e; }
.type-property { background: #eaf8ef; color: #38a169; }
.message-content { flex: 1; min-width: 0; margin-left: 20rpx; }
.message-heading { display: flex; align-items: center; gap: 12rpx; }
.message-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 30rpx; font-weight: 600; color: var(--color-text-primary); }
.unread-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--color-danger); }
.message-text { display: -webkit-box; margin-top: 10rpx; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.55; }
.message-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.message-type { padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; }
.message-time { color: var(--color-text-hint); font-size: 22rpx; }
.message-card.is-unread .message-time { color: var(--color-primary); }
.load-more { padding: 16rpx 0 6rpx; color: var(--color-text-hint); text-align: center; font-size: 24rpx; }
.empty-state { padding-top: 220rpx; }
.empty-image { width: 112rpx; height: 112rpx; padding: 30rpx; border-radius: 50%; background: #eef0ff; opacity: .82; }
.empty-title { margin-top: 28rpx; color: var(--color-text-primary); font-size: 32rpx; font-weight: 600; }
.empty-hint { margin-top: 10rpx; color: var(--color-text-hint); font-size: 25rpx; }
