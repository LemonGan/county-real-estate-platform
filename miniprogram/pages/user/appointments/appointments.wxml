<!-- 看房预约页 -->
<view class="appointments-container">
  <!-- 标签切换 -->
  <view class="tabs-container">
    <scroll-view class="tabs-scroll" scroll-x>
      <view class="tabs">
        <view class="tab-item {{activeTab === item.key ? 'active' : ''}}"
              wx:for="{{tabs}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="switchTab">
          {{item.label}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 预约列表 -->
  <view class="appointments-list" wx:if="{{!loading && !empty}}">
    <view class="appointment-item"
          wx:for="{{appointments}}"
          wx:key="id"
          bindtap="goToAppointmentDetail"
          data-id="{{item.id}}">
      <!-- 房源信息 -->
      <view class="property-header">
        <image class="property-thumb"
               src="{{item.property.images[0] ? item.property.images[0].url : '/assets/images/default-property.png'}}"
               mode="aspectFill"
               catchtap="goToDetail"
               data-id="{{item.property.id}}"></image>
        <view class="property-info">
          <view class="property-title">{{item.property.title}}</view>
          <view class="property-address">{{item.property.address}}</view>
        </view>
        <view class="status-badge {{getStatusClass(item.status)}}">
          {{getStatusText(item.status)}}
        </view>
      </view>

      <!-- 预约信息 -->
      <view class="appointment-info">
        <view class="info-row">
          <image class="info-icon" src="/assets/icons/time.png"></image>
          <text class="info-label">预约时间：</text>
          <text class="info-value">{{item.appointment_time}}</text>
        </view>
        <view class="info-row">
          <image class="info-icon" src="/assets/icons/user.png"></image>
          <text class="info-label">联系人：</text>
          <text class="info-value">{{item.contact_name}}</text>
        </view>
        <view class="info-row">
          <image class="info-icon" src="/assets/icons/phone.png"></image>
          <text class="info-label">联系电话：</text>
          <text class="info-value">{{item.contact_phone}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-buttons" wx:if="{{item.status === 'pending' || item.status === 'confirmed'}}">
        <button class="action-btn cancel-btn"
                catchtap="cancelAppointment"
                data-id="{{item.id}}"
                data-index="{{index}}">取消预约</button>
        <button class="action-btn contact-btn"
                catchtap="contactAgent"
                data-phone="{{item.agent && item.agent.phone}}">联系经纪人</button>
      </view>

      <!-- 已取消状态 -->
      <view class="action-buttons" wx:if="{{item.status === 'cancelled'}}">
        <button class="action-btn rebook-btn"
                catchtap="rebook"
                data-property-id="{{item.property.id}}">重新预约</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:if="{{!loading && empty}}">
    <image class="empty-icon" src="/assets/images/empty-appointments.png"></image>
    <text class="empty-text">暂无预约记录</text>
    <text class="empty-tip">快去预约看房吧</text>
    <button class="empty-btn" bindtap="goToList">去逛逛</button>
  </view>
</view>
