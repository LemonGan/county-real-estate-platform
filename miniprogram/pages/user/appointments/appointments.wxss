/* 预约列表页面样式 */
.appointments-container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 标签切换 */
.tabs-container {
  background: #fff;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tabs-scroll {
  width: 100%;
}

.tabs {
  display: flex;
  padding: 0 30rpx;
}

.tab-item {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  background: #f8f9fa;
  white-space: nowrap;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 加载中 */
.loading-container {
  padding: 60rpx 0;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 20rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 预约列表 */
.appointments-list {
  padding: 30rpx;
}

.appointment-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.appointment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.appointment-status {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.status-pending {
  background: #fff7e6;
  color: #fa8c16;
}

.status-confirmed {
  background: #e6f7e6;
  color: #52c41a;
}

.status-completed {
  background: #e6e9ff;
  color: #667eea;
}

.status-cancelled {
  background: #f5f5f5;
  color: #999;
}

.appointment-property {
  display: flex;
  margin-bottom: 20rpx;
}

.property-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.property-info {
  flex: 1;
}

.property-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.property-address {
  font-size: 24rpx;
  color: #999;
}

.appointment-info {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}



/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部占位 */
.bottom-space {
  height: 120rpx;
}


.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}