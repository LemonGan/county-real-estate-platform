/* 设置页面样式 - 现代风格 */
.setting-container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 设置区块 */
.setting-section {
  background: #fff;
  margin: 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
}

.setting-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
}

.setting-title {
  font-size: 30rpx;
  color: #333;
}

.setting-right {
  display: flex;
  align-items: center;
}

.setting-value {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

/* 退出登录按钮 */
.logout-btn {
  margin: 60rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: #ff4d4f;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 60rpx 0;
  font-size: 24rpx;
  color: #999;
}
