/* 注册页面样式 - 现代风格 */
.register-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx;
}

/* 头部 */
.header {
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 表单容器 */
.form-container {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 48rpx;
  padding: 24rpx 30rpx;
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  opacity: 0.4;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
}

.input-placeholder {
  color: #999;
}

/* 验证码 */
.verify-wrapper {
  display: flex;
  align-items: center;
}

.verify-input {
  flex: 1;
}

.verify-btn {
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: 40rpx;
  margin-left: 20rpx;
}

.verify-btn.disabled {
  background: #ccc;
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  padding: 28rpx 0;
  text-align: center;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

/* 用户协议 */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #999;
}

.link {
  color: #667eea;
  margin: 0 4rpx;
}

/* 登录链接 */
.login-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-link .link {
  color: #fff;
  font-weight: 500;
}
