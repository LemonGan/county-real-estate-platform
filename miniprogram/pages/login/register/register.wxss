/* pages/login/register/register.wxss */
.register-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 0 40rpx;
}

/* 头部 */
.header {
  padding: 80rpx 0 60rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

/* 表单容器 */
.form-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 24rpx;
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.input-placeholder {
  color: #999;
}

/* 验证码 */
.code-wrapper {
  padding-right: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #667eea;
  background-color: transparent;
  border: 1rpx solid #667eea;
  border-radius: 4rpx;
  line-height: 1.5;
}

.code-btn::after {
  border: none;
}

.code-btn[disabled] {
  color: #999;
  border-color: #d9d9d9;
}

/* 用户协议 */
.agreement {
  margin: 32rpx 0;
}

.agreement-label {
  display: flex;
  align-items: center;
}

.agreement-text {
  font-size: 24rpx;
  color: #666;
  margin-left: 8rpx;
}

.agreement-link {
  font-size: 24rpx;
  color: #667eea;
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  height: 88rpx;
  background-color: #667eea;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  margin-top: 32rpx;
}

.register-btn::after {
  border: none;
}

/* 返回登录 */
.back-login {
  text-align: center;
  margin-top: 32rpx;
}

.back-text {
  font-size: 28rpx;
  color: #666;
}

.back-link {
  font-size: 28rpx;
  color: #667eea;
  margin-left: 8rpx;
}
