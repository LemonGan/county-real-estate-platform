<!-- 登录页 - 简洁版 -->
<view class="login-container">
  <!-- Logo区域 -->
  <view class="logo-section">
    <image class="logo" src="/assets/images/logo.png" mode="aspectFit"></image>
    <text class="app-name">县域房产</text>
    <text class="app-slogan">找房·看房·租房</text>
  </view>

  <!-- 微信授权登录按钮 -->
  <view class="login-section">
    <button class="wechat-login-btn" bindtap="handleWechatLogin">
      <image class="btn-icon" src="/assets/icons/wechat.png" mode="aspectFit"></image>
      <text>微信授权登录</text>
    </button>
    
    <view class="login-tip">
      <text>登录后即可享受更多服务</text>
    </view>
  </view>

  <!-- 游客模式 -->
  <view class="guest-section">
    <text class="guest-btn" bindtap="goToHome">暂不登录，先看看</text>
  </view>

  <!-- 用户协议 -->
  <view class="agreement-section">
    <text class="agreement-text">登录即表示同意</text>
    <text class="link" bindtap="showAgreement">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="link" bindtap="showPrivacy">《隐私政策》</text>
  </view>
</view>
