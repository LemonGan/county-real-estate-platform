/* 登录页样式 */
.login-container {
  min-height: 100vh;
  background: var(--color-gradient);
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 60rpx 60rpx;
}
.logo-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 120rpx; }
.logo {
  width: 160rpx; height: 160rpx; border-radius: 32rpx;
  background: var(--color-card); box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
  margin-bottom: 32rpx;
}
.app-name { font-size: 48rpx; font-weight: bold; color: #fff; margin-bottom: 16rpx; }
.app-slogan { font-size: var(--font-md); color: rgba(255,255,255,0.8); }

/* 微信登录按钮 */
.login-section { width: 100%; margin-bottom: 40rpx; }
.wechat-login-btn {
  width: 100%; height: 96rpx; background: #fff;
  border-radius: var(--radius-round); display: flex; align-items: center;
  justify-content: center; font-size: var(--font-lg); font-weight: 500;
  color: var(--color-text-primary); box-shadow: var(--shadow-lg);
}
.wechat-login-btn::after { border: none; }
.btn-icon { width: 44rpx; height: 44rpx; margin-right: 16rpx; }
.login-tip { text-align: center; margin-top: 24rpx; font-size: var(--font-sm); color: rgba(255,255,255,0.7); }
.guest-section { margin-top: 20rpx; }
.guest-btn { font-size: var(--font-sm); color: rgba(255,255,255,0.8); padding: 20rpx 40rpx; }

/* 用户协议 */
.agreement-section {
  position: fixed; bottom: 60rpx; left: 0; right: 0;
  display: flex; justify-content: center; align-items: center;
  flex-wrap: wrap; padding: 0 40rpx; font-size: var(--font-sm);
}
.agreement-text { color: rgba(255,255,255,0.6); }
.link { color: #fff; margin: 0 4rpx; }
