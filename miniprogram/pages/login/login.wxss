/* 登录页样式 - 简洁现代版 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 60rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 32rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录按钮区域 */
.login-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.wechat-login-btn::after {
  border: none;
}

.btn-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}

.login-tip {
  text-align: center;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 游客模式 */
.guest-section {
  margin-top: 20rpx;
}

.guest-btn {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 20rpx 40rpx;
}

/* 用户协议 */
.agreement-section {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  padding: 0 40rpx;
  font-size: 24rpx;
}

.agreement-text {
  color: rgba(255, 255, 255, 0.6);
}

.link {
  color: #fff;
  margin: 0 4rpx;
}
