/* pages/property/map/map.wxss */
.map-page {
  width: 100%;
  height: 100vh;
  position: relative;
}

/* 地图搜索栏 */
.map-search-bar {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 200;
  pointer-events: auto;
}

.search-bar-content {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10px);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.clear-search {
  margin-left: 16rpx;
  padding: 8rpx;
  flex-shrink: 0;
}

.close-icon-small {
  width: 32rpx;
  height: 32rpx;
}

/* 地图容器 */
.property-map {
  width: 100%;
  height: 100%;
}

/* 地图按钮容器 - 作为地图的overlay */
.map-buttons-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 100;
}

/* 地图按钮 - 修改定位为相对于容器 */
.location-btn {
  position: absolute;
  right: 24rpx;
  bottom: 320rpx;
  width: 88rpx;
  height: 88rpx;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  pointer-events: auto;
}

.location-icon {
  width: 48rpx;
  height: 48rpx;
  pointer-events: auto;
}

.filter-btn {
  position: absolute;
  right: 24rpx;
  bottom: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  pointer-events: auto;
}

.filter-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
  pointer-events: auto;
}

.filter-text {
  font-size: 22rpx;
  color: #333;
  pointer-events: auto;
}

.switch-btn {
  position: absolute;
  right: 24rpx;
  bottom: 220rpx;
  width: 88rpx;
  height: 88rpx;
  background-color: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  pointer-events: auto;
}

.switch-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: bold;
  pointer-events: auto;
}

/* 房源卡片 */
.property-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  transform: translateY(120%);
  transition: transform 0.3s ease;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.property-card.show {
  transform: translateY(0);
}

.card-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.close-icon {
  width: 24rpx;
  height: 24rpx;
}

.card-content {
  display: flex;
  padding: 24rpx;
}

.property-image {
  width: 240rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.property-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.property-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.property-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 12rpx 0;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.tag-primary {
  background-color: #e6e9ff;
  color: #667eea;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
}

.tag-warning {
  background-color: #fffbe6;
  color: #faad14;
}

.property-address {
  display: flex;
  align-items: center;
  margin: 8rpx 0;
}

.address-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.address-text {
  font-size: 24rpx;
  color: #8c8c8c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.property-price {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.price-unit {
  font-size: 20rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

.price-per-sqm {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-left: 16rpx;
}

.card-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  border-top: 1rpx solid #e8e8e8;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: none;
  border-radius: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background-color: #667eea;
  color: #fff;
}

.action-btn.secondary {
  background-color: #fff;
  color: #667eea;
  border-left: 1rpx solid #e8e8e8;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 筛选面板 */
.filter-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  pointer-events: none;
}

.filter-panel.show {
  pointer-events: auto;
}

.filter-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0;
  transition: opacity 0.3s;
}

.filter-panel.show .filter-mask {
  opacity: 1;
}

.filter-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.filter-panel.show .filter-content {
  transform: translateY(0);
}

.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.filter-actions {
  display: flex;
  gap: 24rpx;
}

.reset-btn,
.close-filter {
  font-size: 28rpx;
  color: #667eea;
}

.filter-body {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.filter-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.price-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.range-input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.range-separator {
  font-size: 28rpx;
  color: #8c8c8c;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.option-item {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  transition: all 0.2s;
}

.option-item.active {
  background-color: #e6e9ff;
  color: #667eea;
  border: 1rpx solid #667eea;
}

.filter-footer {
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8e8e8;
}

.apply-btn {
  width: 100%;
  height: 88rpx;
  background-color: #667eea;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

.apply-btn::after {
  border: none;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 中心位置显示 */
.center-location-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-info {
  display: flex;
  align-items: center;
  flex: 1;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.location-icon-small {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.location-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.location-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.location-coords {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.arrow-right-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 16rpx;
}

.clear-location-btn {
  margin-left: 16rpx;
  padding: 16rpx 24rpx;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 选择模式提示 */
.select-mode-tip {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 100;
}

.tip-text {
  font-size: 26rpx;
}

.tip-cancel {
  padding: 8rpx 24rpx;
  background-color: #ff4d4f;
  border-radius: 20rpx;
  font-size: 24rpx;
}
