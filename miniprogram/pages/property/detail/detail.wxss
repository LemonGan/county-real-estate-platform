/* 房源详情页样式 */
page { background-color: #f5f5f5; }
.detail-container { min-height: 100vh; padding-bottom: 240rpx; }
.loading-container { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 200rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #f0f0f0; border-top-color: #667eea; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #999; }
.image-swiper { position: relative; background: #000; }
.swiper { width: 100%; height: 500rpx; }
.swiper-image { width: 100%; height: 100%; }
.image-counter { position: absolute; bottom: 20rpx; right: 20rpx; padding: 8rpx 24rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 24rpx; border-radius: 20rpx; }

/* 轮播图上的VR/视频标签 - 贝壳风格 */
.media-tags { position: absolute; top: 20rpx; left: 20rpx; display: flex; gap: 16rpx; }
.media-tag { display: flex; align-items: center; padding: 10rpx 20rpx; background: rgba(0,0,0,0.6); border-radius: 30rpx; }
.media-tag .tag-icon { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.media-tag text { color: #fff; font-size: 22rpx; }

.price-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.price-row { display: flex; align-items: baseline; margin-bottom: 16rpx; }
.price { font-size: 48rpx; font-weight: 700; color: #ff6b6b; }
.price-unit { font-size: 24rpx; color: #999; margin-left: 8rpx; }
.price-tags { display: flex; gap: 12rpx; }
.tag { padding: 6rpx 16rpx; background: #f0f0f0; border-radius: 8rpx; font-size: 22rpx; color: #666; }
.tag.highlight { background: rgba(102,126,234,0.1); color: #667eea; }
.tag.transaction-tag { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; }
.info-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 24rpx; }
.info-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24rpx; }
.info-item { display: flex; justify-content: space-between; }
.info-label { font-size: 26rpx; color: #999; }
.info-value { font-size: 26rpx; color: #333; font-weight: 500; }
.title-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.title { display: block; font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.subtitle { display: block; font-size: 26rpx; color: #666; }
.location-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; display: flex; align-items: center; }
.location-icon { width: 40rpx; height: 40rpx; margin-right: 16rpx; }
.location-info { flex: 1; }
.location-name { display: block; font-size: 28rpx; font-weight: 500; color: #333; margin-bottom: 8rpx; }
.location-address { display: block; font-size: 24rpx; color: #999; }
.description-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.description-text { font-size: 26rpx; color: #666; line-height: 1.8; }

/* 操作按钮组 */
.action-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; display: flex; justify-content: space-around; }
.action-item { display: flex; flex-direction: column; align-items: center; background: transparent; border: none; }
.action-item::after { border: none; }
.action-icon { width: 48rpx; height: 48rpx; margin-bottom: 8rpx; }
.action-text { font-size: 24rpx; color: #666; }

.agent-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.agent-info { display: flex; align-items: center; }
.agent-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin-right: 20rpx; }
.agent-detail { flex: 1; }
.agent-name { display: block; font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.agent-title { font-size: 24rpx; color: #667eea; }
.contact-btn { padding: 12rpx 32rpx; background: #667eea; color: #fff; border-radius: 32rpx; font-size: 24rpx; border: none; }
.publish-time { text-align: center; padding: 30rpx; font-size: 24rpx; color: #999; }

/* 底部固定按钮 */
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 30rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #eee; z-index: 999; }
.bottom-btn { flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 44rpx; font-size: 30rpx; font-weight: 500; }
.bottom-btn.gray { background: #f5f5f5; color: #333; margin-right: 20rpx; }
.bottom-btn.primary { background: linear-gradient(135deg,#667eea,#764ba2); color: #fff; }
