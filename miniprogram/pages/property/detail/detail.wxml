<!-- 房源详情页 -->
<view class="detail-container">
  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 房源详情 -->
  <view class="detail-content" wx:if="{{!loading && property}}">
    <!-- 图片轮播（类似贝壳） -->
    <view class="image-swiper">
      <swiper class="swiper" current="{{currentImageIndex}}" bindchange="onImageChange" indicator-dots="{{imageUrls.length > 1}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#fff" autoplay>
        <swiper-item wx:for="{{imageUrls}}" wx:key="index" wx:for-item="image">
          <image class="swiper-image" src="{{image}}" mode="aspectFill" bindtap="previewImage" data-url="{{image}}" data-urls="{{imageUrls}}"></image>
        </swiper-item>
      </swiper>
      <!-- 左上角VR/视频标签 -->
      <view class="media-tags" wx:if="{{property.has_vr || property.has_video}}">
        <view class="media-tag" wx:if="{{property.has_vr}}" bindtap="viewVR">
          <image class="tag-icon" src="/assets/icons/vr.png"></image>
          <text>VR</text>
        </view>
        <view class="media-tag" wx:if="{{property.has_video}}" bindtap="viewVideo">
          <image class="tag-icon" src="/assets/icons/video.png"></image>
          <text>视频</text>
        </view>
      </view>
      <!-- 左下角图片数量 -->
      <view class="image-counter">
        <text>{{currentImageIndex + 1}}/{{imageUrls.length}}</text>
      </view>
    </view>

    <!-- 价格区域 -->
    <view class="section-card price-section">
      <view class="price-row">
        <text class="price">{{property.price/10000}}万</text>
        <text class="price-unit">{{property.transaction_type === 2 ? '元/月' : '元/套'}}</text>
      </view>
      <view class="price-tags">
        <text class="tag transaction-tag">{{property.transaction_type === 1 ? '出售' : '出租'}}</text>
        <text class="tag" wx:if="{{property.decoration_type}}">{{property.decoration_type}}</text>
        <text class="tag" wx:if="{{property.orientation}}">{{property.orientation}}</text>
        <text class="tag highlight">{{property.property_type}}</text>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="section-card info-section">
      <view class="section-title">基本信息</view>
      <view class="info-grid">
        <view class="info-item"><text class="info-label">房型</text><text class="info-value">{{property.rooms}}室{{property.halls}}厅{{property.bathrooms}}卫</text></view>
        <view class="info-item"><text class="info-label">面积</text><text class="info-value">{{property.area}}㎡</text></view>
        <view class="info-item"><text class="info-label">楼层</text><text class="info-value">{{property.floor}}/{{property.total_floors}}层</text></view>
        <view class="info-item"><text class="info-label">建筑年代</text><text class="info-value">{{property.build_year}}年</text></view>
        <view class="info-item"><text class="info-label">朝向</text><text class="info-value">{{property.orientation || '--'}}</text></view>
        <view class="info-item"><text class="info-label">装修</text><text class="info-value">{{property.decoration_type || '--'}}</text></view>
      </view>
    </view>

    <!-- 房源标题 -->
    <view class="section-card title-section">
      <text class="title">{{property.title}}</text>
      <text class="subtitle" bindtap="goToCommunity">{{property.community_name}} ›</text>
    </view>

    <!-- 位置信息 -->
    <view class="section-card location-section">
      <image class="location-icon" src="/assets/icons/location.png"></image>
      <view class="location-info">
        <text class="location-name">{{property.community_name}}</text>
        <text class="location-address">{{property.address}}</text>
      </view>
    </view>

    <!-- 房源描述 -->
    <view class="section-card description-section" wx:if="{{property.description}}">
      <view class="section-title">房源描述</view>
      <text class="description-text">{{property.description}}</text>
    </view>

    <!-- 操作按钮组 -->
    <view class="section-card action-section">
      <view class="action-item" bindtap="toggleFavorite">
        <image class="action-icon" src="{{isFavorite ? '/assets/icons/favorite-filled.png' : '/assets/icons/favorite.png'}}"></image>
        <text class="action-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="action-item" bindtap="toggleCompare">
        <text class="action-emoji">{{inCompare ? '✅' : '⚖️'}}</text>
        <text class="action-text">{{inCompare ? '已对比' : '对比'}}</text>
      </view>
      <view class="action-item" bindtap="makePoster">
        <text class="action-emoji">🖼️</text>
        <text class="action-text">海报</text>
      </view>
      <button class="action-item" open-type="share">
        <image class="action-icon" src="/assets/icons/share.png"></image>
        <text class="action-text">分享</text>
      </button>
    </view>

    <!-- 经纪人信息 -->
    <view class="section-card agent-section" wx:if="{{property.agent}}">
      <view class="section-title">房源经纪人</view>
      <view class="agent-info">
        <image class="agent-avatar" src="{{property.agent.avatar || '/assets/images/default-avatar.png'}}"></image>
        <view class="agent-detail">
          <text class="agent-name">{{property.agent.nickname}}</text>
          <text class="agent-title">金牌经纪人</text>
        </view>
        <button class="contact-btn" bindtap="callAgent" wx:if="{{property.agent.phone}}">📞 致电</button>
        <button class="contact-btn" bindtap="contactAgent" wx:else>联系</button>
      </view>
    </view>

    <!-- 发布时间 -->
    <view class="publish-time">发布于 {{property.created_at}}</view>
  </view>

  <!-- 底部固定按钮 -->
  <view class="bottom-bar">
    <view class="bottom-btn gray" bindtap="callAgent" wx:if="{{property.agent && property.agent.phone}}">📞 电话咨询</view>
    <view class="bottom-btn gray" bindtap="contactAgent" wx:else>电话咨询</view>
    <view class="bottom-btn primary" bindtap="makeAppointment">预约看房</view>
  </view>
</view>
