
.back-btn {
  padding: 20rpx;
  background: #fff;
  font-size: 28rpx;
  color: #667eea;
  border-bottom: 1rpx solid #eee;
}
/* pages/property/review/review.wxss */
.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 120rpx;
}

/* 评分概览 */
.rating-overview {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  padding: 50rpx 40rpx;
}

.rating-left {
  text-align: center;
}

.rating-score {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  color: #fff;
}

.rating-stars {
  display: flex;
  justify-content: center;
  margin: 16rpx 0;
}

.star {
  font-size: 36rpx;
  color: rgba(255,255,255,0.4);
  margin: 0 4rpx;
}

.star.active {
  color: #fff;
}

.rating-count {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

/* 评价列表 */
.review-list {
  padding: 30rpx;
}

.review-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.review-header {
  display: flex;
  align-items: center;
}

.review-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.review-info {
  flex: 1;
}

.review-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.review-stars {
  display: flex;
  margin-top: 8rpx;
}

.review-stars .star {
  color: #ddd;
  font-size: 24rpx;
}

.review-stars .star.active {
  color: #ffc107;
}

.review-time {
  font-size: 22rpx;
  color: #999;
}

.review-content {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 16rpx;
}

.review-images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.review-upload-title { display: block; margin-top: 26rpx; color: #374151; font-size: 26rpx; font-weight: 600; }
.review-upload-title text { margin-left: 8rpx; color: #9ca3af; font-size: 22rpx; font-weight: 400; }
.review-upload-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.review-upload-item, .review-image-add { position: relative; width: 148rpx; height: 148rpx; overflow: hidden; border-radius: 14rpx; }
.review-upload-item image { width: 100%; height: 100%; }
.review-image-remove { position: absolute; top: 4rpx; right: 4rpx; display: flex; width: 34rpx; height: 34rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(0,0,0,.6); color: #fff; font-size: 27rpx; line-height: 1; }
.review-image-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #cfd7e3; background: #f8fafc; color: #758196; font-size: 21rpx; }
.review-image-add-icon { margin-bottom: 4rpx; color: #667eea; font-size: 43rpx; line-height: 1; }

/* 我的评价审核状态 */
.my-review-status { margin: 0 30rpx 28rpx; padding: 24rpx 26rpx; border: 1rpx solid transparent; border-radius: 18rpx; background: #fff; }
.my-review-head { display: flex; align-items: center; justify-content: space-between; }
.my-review-title { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.my-review-rating { font-size: 24rpx; color: #64748b; }
.my-review-hint, .my-review-note { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 1.55; }
.status-pending { border-color: #f5d58a; background: #fff9e9; }.status-pending .my-review-hint { color: #9a6700; }
.status-approved { border-color: #a7dfbf; background: #f0fbf4; }.status-approved .my-review-hint { color: #207345; }
.status-rejected { border-color: #f3b2b2; background: #fff3f2; }.status-rejected .my-review-hint, .status-rejected .my-review-note { color: #b64040; }

/* 评价按钮 */
.fab {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 172, 254, 0.4);
}

.fab text {
  color: #fff;
  font-size: 30rpx;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
}

.modal-body {
  padding: 40rpx;
}

.rating-select {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.stars {
  display: flex;
}

.stars .star {
  font-size: 44rpx;
  color: #ddd;
  margin-right: 8rpx;
}

.stars .star.active {
  color: #ffc107;
}

.review-input {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.modal-footer {
  padding: 20rpx 40rpx 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  border: none;
}
