<!-- pages/property/review/review.wxml -->
<view class="container">
  <!-- 评分概览 -->
  <view class="rating-overview" wx:if="{{stats.total_count > 0}}">
    <view class="rating-left">
      <text class="rating-score">{{stats.avg_rating}}</text>
      <view class="rating-stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{item <= stats.avgRating ? 'active' : ''}}">★</text>
      </view>
      <text class="rating-count">{{stats.total_count}} 条评价</text>
    </view>
  </view>

  <!-- 评价列表 -->
  <view class="review-list">
    <view class="review-item" wx:for="{{reviewList}}" wx:key="id">
      <view class="review-header">
        <image class="review-avatar" src="{{item.user_avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="review-info">
          <text class="review-name">{{item.user_nickname}}</text>
          <view class="review-stars">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="s" class="star {{item <= item.rating ? 'active' : ''}}" style="{{index < item.rating ? 'color:#ffc107' : ''}}">★</text>
          </view>
        </view>
        <text class="review-time">{{item.created_at}}</text>
      </view>
      <view class="review-content">
        <text>{{item.content}}</text>
      </view>
      <view class="review-images" wx:if="{{item.displayImages.length > 0}}">
        <image wx:for="{{item.displayImages}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}"></image>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{reviewList.length === 0 && !loading}}">
    <text>暂无已审核评价</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="my-review-status status-{{myReviewStatus.className}}" wx:if="{{myReviewStatus}}">
    <view class="my-review-head">
      <text class="my-review-title">我的评价 · {{myReviewStatus.label}}</text>
      <text class="my-review-rating">{{myReview.rating || 0}} / 5 分</text>
    </view>
    <text class="my-review-hint">{{myReviewStatus.hint}}</text>
    <text class="my-review-note" wx:if="{{myReviewStatus.note}}">审核备注：{{myReviewStatus.note}}</text>
  </view>

  <!-- 评价按钮 -->
  <view class="fab" bindtap="openReviewModal" wx:if="{{!hasReviewed || canResubmit}}">
    <text>{{canResubmit ? '修改后重新提交' : '写评价'}}</text>
  </view>

  <!-- 评价弹窗 -->
  <view class="modal" wx:if="{{showModal}}">
    <view class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">发表评价</text>
        <text class="modal-close" bindtap="closeModal">×</text>
      </view>
      <view class="modal-body">
        <view class="rating-select">
          <text class="rating-label">评分</text>
          <view class="stars">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{item <= myRating ? 'active' : ''}}" bindtap="setRating" data-rating="{{item}}">★</text>
          </view>
        </view>
        <textarea class="review-input" value="{{content}}" placeholder="分享您的看房体验..." bindinput="onContentInput" maxlength="500"></textarea>
        <view class="word-count">{{contentLength}}/500</view>
        <view class="review-upload-title">现场图片 <text>选填，最多 3 张</text></view>
        <view class="review-upload-grid">
          <view class="review-upload-item" wx:for="{{reviewImages}}" wx:key="url">
            <image src="{{item.displayUrl}}" mode="aspectFill" bindtap="previewReviewImage" data-index="{{index}}"></image>
            <view class="review-image-remove" bindtap="removeReviewImage" data-index="{{index}}">×</view>
          </view>
          <view class="review-image-add" wx:if="{{reviewImages.length < 3}}" bindtap="chooseReviewImages">
            <text class="review-image-add-icon">{{uploadingImages ? '…' : '+'}}</text>
            <text>{{uploadingImages ? '上传中' : '添加图片'}}</text>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="submit-btn" bindtap="submitReview">提交评价</button>
      </view>
    </view>
  </view>
</view>
