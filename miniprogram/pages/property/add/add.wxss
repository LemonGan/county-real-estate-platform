/* pages/property/add/add.wxss */
.add-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.form-scroll {
  height: 100vh;
}

.form-section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #667eea;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 交易类型选择器 */
.type-selector {
  display: flex;
  gap: 20rpx;
  flex: 1;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.type-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.form-row {
  display: flex;
  align-items: center;
}

.form-item-small {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.form-item-small .label {
  width: auto;
  margin-right: 10rpx;
}

.form-item-small .input {
  width: 80rpx;
  text-align: center;
}

.form-item-half {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.form-item-half .label {
  width: 140rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.word-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.image-item .image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  background: #f8f9fa;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #999;
}

.add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}

/* 视频上传 */
.video-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  border: 2rpx dashed #ddd;
}
.upload-icon { font-size: 60rpx; }
.upload-text { font-size: 24rpx; color: #666; margin-top: 10rpx; }
.video-preview { position: relative; width: 400rpx; }
.video-player { width: 100%; height: 300rpx; border-radius: 16rpx; }

/* VR链接输入 */
.vr-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

/* 底部提交 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.08);
}

.submit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  padding: 28rpx 0;
  text-align: center;
}

.submit-btn[disabled]

.location-btn {
  flex: 1;
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #667eea;
  text-align: center;
  border: 2rpx dashed #667eea;
}

.location-btn:active {
  background: #e8e8ff;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
