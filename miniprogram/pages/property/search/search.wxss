/* 房源搜索页面样式 - 现代风格 */
.search-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 24rpx 30rpx;
  gap: 20rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  min-height: 72rpx;
  max-width: 600rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.clear-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 60rpx;
  line-height: 60rpx;
  min-height: 60rpx;
}

.search-btn {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 搜索内容区域 */
.search-content {
  padding: 30rpx;
}

/* 区块通用样式 */
.history-section,
.hot-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 区块头部 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.delete-icon,
.hot-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

/* 历史记录列表 - 标签云风格 */
.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #f0f2f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #555;
  transition: all 0.2s;
}

.history-item:active {
  background: #e8e8e8;
  transform: scale(0.98);
}

/* 热门搜索 - 标签云风格 */
.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
  transition: all 0.2s;
}

.hot-item:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 搜索结果 */
.search-results {
  padding: 20rpx;
  min-height: calc(100vh - 120rpx);
  background: #f5f5f5;
}

/* 房源搜索结果列表 */
.results-list {
  display: flex;
  flex-direction: column;
}

.result-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.result-image {
  width: 240rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.result-tags .tag {
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #f0f2f5 0%, #e8e8e8 100%);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.result-tags .tag:first-child {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  color: #1890ff;
}

.result-address {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-price {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
}

.result-price .price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.result-price .unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 6rpx;
}

/* 位置搜索结果 */
.location-results-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.location-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.location-item:last-child {
  border-bottom: none;
}

.location-item:active {
  background: #fafafa;
}

.location-info {
  flex: 1;
}

.location-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.location-address {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.location-category {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #1890ff;
  margin-top: 12rpx;
}

.location-arrow {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.3;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  min-height: 60vh;
}

.empty-icon {
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 16rpx;
}

.filter-btn {
  margin-top: 40rpx;
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.filter-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 加载中 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

/* 视图切换栏 */
.view-toggle-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 30rpx;
  gap: 20rpx;
}

.view-toggle {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.view-toggle.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 地图视图 */
.map-view {
  position: fixed;
  top: 250rpx;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.search-map {
  width: 100%;
  height: 100%;
}

/* 地图房源卡片 */
.map-property-card {
  position: absolute;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  transform: translateY(120%);
  transition: transform 0.3s ease;
}

.map-property-card.show {
  transform: translateY(0);
}

.map-property-card .card-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 10;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
}

.map-property-card .card-close .close-icon {
  width: 32rpx;
  height: 32rpx;
}

.map-property-card .card-content {
  display: flex;
  padding: 20rpx;
}

.map-property-card .card-image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.map-property-card .card-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.map-property-card .card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-property-card .card-tags {
  display: flex;
  gap: 10rpx;
}

.map-property-card .card-tags .tag {
  padding: 6rpx 12rpx;
  background: #f0f2f5;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.map-property-card .card-price {
  display: flex;
  align-items: baseline;
}

.map-property-card .card-price .price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.map-property-card .card-price .unit {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}
