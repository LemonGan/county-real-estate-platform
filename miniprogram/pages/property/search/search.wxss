/* 房源搜索样式 */
.search-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 位置选择模式 */
.location-mode-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.location-mode-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 64rpx 48rpx;
  width: 100%;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.location-icon-large {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

.location-mode-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.location-mode-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 48rpx;
}

.location-mode-tips {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 48rpx;
  padding: 32rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.tip-item {
  font-size: 26rpx;
  color: #666;
  line-height: 2;
}

.reopen-btn {
  width: 100%;
  height: 88rpx;
  background-color: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.reopen-btn::after {
  border: none;
}

.reopen-btn:active {
  background-color: #5568d3;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  margin-right: 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-btn {
  font-size: 28rpx;
  color: #667eea;
  white-space: nowrap;
}

/* 搜索内容 */
.search-content {
  padding: 32rpx;
}

/* 搜索历史 */
.history-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.hot-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.delete-icon {
  width: 32rpx;
  height: 32rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  padding: 16rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

/* 热门搜索 */
.hot-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-item {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #667eea;
}

/* 搜索结果 */
.search-results {
  padding: 20rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 结果列表 */
.results-list {
  display: flex;
  flex-direction: column;
}

.result-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.result-image {
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.result-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.result-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.result-tags .tag {
  padding: 6rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: #666;
}

.result-address {
  font-size: 24rpx;
  color: #8c8c8c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.result-price {
  display: flex;
  align-items: baseline;
}

.result-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
  margin-right: 4rpx;
}

.result-price .unit {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 0 32rpx;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #8c8c8c;
  margin-bottom: 48rpx;
}

.filter-btn {
  width: 280rpx;
  height: 80rpx;
  background-color: #667eea;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.filter-btn::after {
  border: none;
}
