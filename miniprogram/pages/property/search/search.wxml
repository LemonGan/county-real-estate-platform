<!-- 搜索页 -->
<view class="search-container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <image class="search-icon" src="/assets/icons/search.png"></image>
      <input class="search-input"
             type="text"
             value="{{keyword}}"
             placeholder="{{mode === 'location' ? '搜索地点、地址、小区' : '搜索小区、地址、房源'}}"
             bindinput="onInputChange"
             bindconfirm="onConfirm" />
      <image class="clear-icon"
             src="/assets/icons/close.png"
             wx:if="{{keyword}}"
             bindtap="clearInput"></image>
    </view>
    <text class="search-btn" bindtap="onConfirm">搜索</text>
  </view>

  <!-- 视图切换按钮 -->
  <view class="view-toggle-bar">
    <view class="view-toggle {{viewMode === 'list' ? 'active' : ''}}" bindtap="switchToListView">
      <text>列表</text>
    </view>
    <view class="view-toggle {{viewMode === 'map' ? 'active' : ''}}" bindtap="switchToMapView">
      <text>地图</text>
    </view>
  </view>

  <!-- 地图视图 -->
  <view class="map-view" wx:if="{{viewMode === 'map'}}">
    <map
      id="searchMap"
      class="search-map"
      longitude="{{mapLongitude}}"
      latitude="{{mapLatitude}}"
      scale="11"
      markers="{{mapMarkers}}"
      show-location="{{true}}"
      bindmarkertap="onMarkerTap"
    ></map>
    
    <!-- 地图房源卡片 -->
    <view class="map-property-card {{showPropertyCard ? 'show' : ''}}" wx:if="{{selectedProperty}}">
      <view class="card-close" bindtap="closePropertyCard">
        <image class="close-icon" src="/assets/icons/close.png" />
      </view>
      <view class="card-content" bindtap="goToDetailFromMap">
        <image class="card-image" src="{{selectedProperty.cover_image_url || '/assets/images/default-property.png'}}" mode="aspectFill" />
        <view class="card-info">
          <view class="card-title">{{selectedProperty.title}}</view>
          <view class="card-tags">
            <text class="tag">{{selectedProperty.area_text}}</text>
            <text class="tag">{{selectedProperty.room_type}}</text>
          </view>
          <view class="card-price">
            <text class="price">{{selectedProperty.total_price_text}}</text>
            <text class="unit">万</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索历史和热门 -->
  <view class="search-content" wx:if="{{showHistory}}">
    <!-- 搜索历史 -->
    <view class="history-section" wx:if="{{history.length > 0}}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <image class="delete-icon"
               src="/assets/icons/delete.png"
               bindtap="clearHistory"></image>
      </view>
      <view class="history-list">
        <view class="history-item"
              wx:for="{{history}}"
              wx:key="*this"
              bindtap="onHistoryTap"
              data-keyword="{{item}}">
          {{item}}
        </view>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="hot-section">
      <view class="section-header">
        <image class="hot-icon" src="/assets/icons/hot.png"></image>
        <text class="section-title">{{mode === 'location' ? '热门位置' : '热门搜索'}}</text>
      </view>
      <view class="hot-list">
        <view class="hot-item"
              wx:for="{{hotSearches}}"
              wx:key="*this"
              bindtap="onHotTap"
              data-keyword="{{item}}">
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{!showHistory}}">
    <!-- 搜索中 -->
    <view class="loading-container" wx:if="{{searching}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">搜索中...</text>
    </view>

    <!-- 位置搜索结果列表 -->
    <view class="location-results-list" wx:if="{{mode === 'location' && !searching && locationResults.length > 0}}">
      <view class="location-item"
            wx:for="{{locationResults}}"
            wx:key="id"
            bindtap="selectLocation"
            data-location="{{item}}">
        <view class="location-info">
          <view class="location-title">{{item.title}}</view>
          <view class="location-address">{{item.address}}</view>
          <view class="location-category" wx:if="{{item.category}}">{{item.category}}</view>
        </view>
        <image class="location-arrow" src="/assets/icons/arrow-right.png"></image>
      </view>
    </view>

    <!-- 房源搜索结果列表 -->
    <view class="results-list" wx:if="{{mode === 'property' && !searching && hasResults}}">
      <view class="result-item"
            wx:for="{{searchResults}}"
            wx:key="id"
            bindtap="goToDetail"
            data-id="{{item.id}}">
        <image class="result-image"
               src="{{item.images && item.images[0] ? item.images[0] : '/assets/images/default-property.png'}}"
               mode="aspectFill"></image>
        <view class="result-info">
          <view class="result-title">{{item.title}}</view>
          <view class="result-tags">
            <text class="tag">{{item.rooms || item.room_count}}室{{item.halls || item.hall_count}}厅</text>
            <text class="tag">{{item.area}}㎡</text>
            <text class="tag" wx:if="{{item.orientation}}">{{item.orientation}}</text>
          </view>
          <view class="result-address">{{item.community_name || item.address || item.detail_address}}</view>
          <view class="result-price">
            <text class="price">{{(item.total_price || item.price) / 10000}}万</text>
            <text class="unit">元/套</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 无结果 -->
    <view class="empty-container" wx:if="{{!searching && ((mode === 'location' && locationResults.length === 0) || (mode === 'property' && !hasResults))}}">
      <image class="empty-icon" src="/assets/images/empty-search.png"></image>
      <text class="empty-text">{{mode === 'location' ? '没有找到相关位置' : '没有找到相关房源'}}</text>
      <text class="empty-tip">{{mode === 'location' ? '换个关键词试试吧' : '试试筛选功能'}}</text>
      <button class="filter-btn" wx:if="{{mode === 'property'}}" bindtap="goToFilter">去筛选</button>
    </view>
  </view>
</view>
