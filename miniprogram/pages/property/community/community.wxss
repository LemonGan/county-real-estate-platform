/* 小区详情 */
.community-container { min-height: 100vh; padding-bottom: 40rpx; }
.cm-header {
  background: var(--color-gradient); padding: 40rpx 32rpx; color: #fff;
}
.cm-name { font-size: var(--font-xxl); font-weight: 700; display: block; margin-bottom: 24rpx; }
.cm-stats { display: flex; }
.cm-stat { flex: 1; text-align: center; }
.cm-stat-val { display: block; font-size: var(--font-xl); font-weight: 700; }
.cm-stat-label { font-size: var(--font-xs); opacity: 0.7; margin-top: 4rpx; }

.cm-list-label {
  padding: 24rpx; font-size: var(--font-lg); font-weight: 600;
  color: var(--color-text-primary);
}

.property-list { padding: 0 24rpx; }
.p-item {
  display: flex; background: var(--color-card); border-radius: var(--radius-md);
  padding: 16rpx; margin-bottom: 16rpx; box-shadow: var(--shadow-sm);
}
.p-thumb { width: 180rpx; height: 130rpx; border-radius: var(--radius-sm); flex-shrink: 0; }
.p-info { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.p-title { font-size: var(--font-md); font-weight: 600; color: var(--color-text-primary); }
.p-meta { font-size: var(--font-xs); color: var(--color-text-hint); }
.p-price { display: flex; align-items: baseline; color: var(--color-price); font-weight: 700; }
.price-num { font-size: var(--font-lg); }
.p-unit { font-size: var(--font-xs); color: var(--color-text-hint); margin-left: 8rpx; font-weight: 400; }
