<!-- 房源海报 -->
<view class="poster-page">
  <!-- 顶部提示 -->
  <view class="pp-header">
    <text class="pp-title">🎨 房源海报</text>
    <text class="pp-desc">长按保存图片，分享给好友或朋友圈</text>
  </view>

  <!-- 海报预览 -->
  <view class="pp-preview" wx:if="{{!saving}}">
    <view class="pp-card">
      <canvas type="2d" id="posterCanvas" class="pp-canvas" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px"></canvas>
    </view>
  </view>

  <!-- 保存中 -->
  <view class="pp-saving" wx:if="{{saving}}">
    <view class="pp-spinner"></view>
    <text>正在生成海报...</text>
  </view>

  <!-- 按钮 -->
  <view class="pp-actions" wx:if="{{!saving}}">
    <view class="pp-btn primary" bindtap="savePoster">📥 保存到相册</view>
  </view>
</view>
