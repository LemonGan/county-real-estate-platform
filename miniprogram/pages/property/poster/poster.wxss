/* 海报页 */
.poster-page {
  min-height: 100vh; background: linear-gradient(180deg, #e8ecff 0%, #f5f7fa 100%);
  display: flex; flex-direction: column; align-items: center; padding: 40rpx 0;
}
.pp-header { text-align: center; margin-bottom: 36rpx; }
.pp-title { display: block; font-size: var(--font-xl); font-weight: 700; color: var(--color-text-primary); margin-bottom: 6rpx; }
.pp-desc { font-size: var(--font-sm); color: var(--color-text-hint); }

.pp-preview { padding: 0 24rpx; }
.pp-card {
  background: #fff; border-radius: var(--radius-lg);
  box-shadow: 0 12rpx 40rpx rgba(102,126,234,0.15); overflow: hidden;
  padding: 8rpx;
}
.pp-canvas { display: block; width: 100%; border-radius: 12rpx; }

.pp-saving {
  display: flex; flex-direction: column; align-items: center;
  padding: 200rpx 0; color: var(--color-text-hint); font-size: var(--font-md);
}
.pp-spinner {
  width: 48rpx; height: 48rpx; border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary); border-radius: 50%;
  animation: spin 0.8s linear infinite; margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.pp-actions { width: calc(100% - 48rpx); margin-top: 40rpx; }
.pp-btn {
  width: 100%; height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx; font-size: var(--font-lg); font-weight: 600;
}
.pp-btn.primary { background: var(--color-gradient); color: #fff; box-shadow: 0 6rpx 20rpx rgba(102,126,234,0.35); }
.pp-btn.primary:active { opacity: 0.85; }
