/* 海报生成 */
.poster-container {
  min-height: 100vh; background: #f0f0f0;
  display: flex; flex-direction: column; align-items: center; padding: 40rpx 0;
}
.poster-preview {
  background: #fff; border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg); overflow: hidden;
}
.poster-canvas { display: block; }

.saving-tip {
  display: flex; flex-direction: column; align-items: center;
  padding: 200rpx 0; color: var(--color-text-hint); font-size: var(--font-md);
}
.saving-icon { font-size: 60rpx; margin-bottom: 20rpx; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.poster-actions {
  display: flex; gap: 20rpx; margin: 40rpx 24rpx; width: calc(100% - 48rpx);
}
.pa-btn {
  flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx; font-size: var(--font-lg); font-weight: 500;
}
.pa-btn.primary { background: var(--color-gradient); color: #fff; box-shadow: 0 6rpx 20rpx rgba(102,126,234,0.35); }
.pa-btn.gray { background: #fff; color: var(--color-text-secondary); }

.poster-tip {
  text-align: center; padding: 20rpx; color: var(--color-text-hint); font-size: var(--font-xs);
}
