/* 海报生成页面样式 */
.container {
  min-height: 100vh;
  background-color: #f8f9fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.poster-wrapper {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.poster-canvas {
  width: 600rpx;
  height: 900rpx;
  background: #fff;
}

.actions {
  display: flex;
  gap: 30rpx;
  margin-top: 40rpx;
  width: 100%;
}

.btn {
  flex: 1;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 48rpx;
  text-align: center;
}

.btn.save {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn.share {
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
}
