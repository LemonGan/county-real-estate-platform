/* 预约看房页面样式 - 现代风格 */
.appointment-container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 加载中 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 房源信息卡片 */
.property-card {
  background: #fff;
  margin: 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.card-header {
  padding: 30rpx 30rpx 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.property-info {
  display: flex;
  padding: 0 30rpx 30rpx;
}

.property-image {
  width: 180rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.property-detail {
  flex: 1;
}

.property-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.property-address {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.property-price {
  display: flex;
  align-items: baseline;
}

.property-price .price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.property-price .unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

textarea.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 16rpx;
}

/* 提交按钮 */
.submit-btn {
  margin: 40rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

/* 底部占位 */
.bottom-space {
  height: 60rpx;
}


/* 占位符样式 */
.placeholder {
  color: #999;
}

/* picker箭头 */
.picker-arrow {
  width: 24rpx;
  height: 24rpx;
}

/* 经纪人卡片 */
.agent-card {
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.agent-info {
  display: flex;
  align-items: center;
}

.agent-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.agent-detail {
  flex: 1;
}

.agent-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.agent-title {
  font-size: 24rpx;
  color: #999;
}

.contact-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
}

/* 温馨提示 */
.tips-card {
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.tips-card .card-header {
  display: flex;
  align-items: center;
  padding: 0 0 20rpx;
}

.tips-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.tips-content {
  padding-left: 10rpx;
}

.tip-item {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}

/* 必填标识 */
.required {
  color: #ff4d4f;
  margin-left: 8rpx;
}
