/* 房源对比 - 纵向卡片 */
.cmp-container { min-height: 100vh; padding-bottom: 140rpx; }
.cmp-content { padding: 16rpx 24rpx; }

/* 头部 */
.cmp-header { padding: 16rpx 0 24rpx; }
.cmp-header-title { font-size: var(--font-xl); font-weight: 700; color: var(--color-text-primary); }
.cmp-header-sub { font-size: var(--font-sm); color: var(--color-text-hint); margin-left: 12rpx; }

/* 卡片 */
.cmp-card {
  background: var(--color-card); border-radius: var(--radius-lg);
  margin-bottom: 20rpx; box-shadow: var(--shadow-sm);
  animation: fadeInUp 0.35s ease both; position: relative; overflow: hidden;
}
.cmp-card-tag {
  position: absolute; top: 0; left: 0;
  background: var(--color-gradient); color: #fff;
  padding: 6rpx 20rpx; border-radius: 0 0 16rpx 0;
  font-size: var(--font-xs); font-weight: 600; z-index: 1;
}

/* 图片 + 信息列 */
.cmp-card-top {
  display: flex; padding: 36rpx 20rpx 20rpx 20rpx;
}
.cmp-card-img {
  width: 200rpx; height: 150rpx; border-radius: var(--radius-sm); flex-shrink: 0;
}
.cmp-card-info { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; min-width: 0; }
.cmp-card-title {
  font-size: var(--font-sm); font-weight: 600; color: var(--color-text-primary);
  line-height: 1.5; margin-bottom: 8rpx;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.cmp-card-price { display: flex; align-items: baseline; margin-bottom: 8rpx; }
.cmp-price-num { font-size: var(--font-xl); font-weight: 700; color: var(--color-price); }
.cmp-price-unit { font-size: var(--font-xs); color: var(--color-text-hint); margin-left: 4rpx; }
.cmp-card-remove {
  font-size: var(--font-xs); color: var(--color-primary); padding: 4rpx 0; align-self: flex-start;
}

/* 属性列表 */
.cmp-attrs {
  display: flex; flex-wrap: wrap; padding: 0 20rpx 20rpx;
}
.cmp-attr {
  width: 50%; display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5;
}
.cmp-attr:nth-child(even) { padding-left: 16rpx; border-left: 1rpx solid #f5f5f5; }
.cmp-attr:nth-child(odd) { padding-right: 16rpx; }
.cmp-attr-label { font-size: var(--font-xs); color: var(--color-text-hint); width: 80rpx; flex-shrink: 0; }
.cmp-attr-val { font-size: var(--font-sm); color: var(--color-text-primary); font-weight: 500; }
.cmp-attr-val-district { color: var(--color-primary); }

/* 底部 */
.cmp-bottom {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; gap: 20rpx; padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card); border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}
.cmpb-btn {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx; font-size: var(--font-lg); font-weight: 500;
}
.cmpb-btn.gray { background: var(--color-bg); color: var(--color-text-primary); }
.cmpb-btn.primary { background: var(--color-gradient); color: #fff; }
