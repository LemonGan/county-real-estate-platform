/* 房源对比 */
.compare-container { min-height: 100vh; padding-bottom: 120rpx; }

/* 空状态 */
.empty-icon { font-size: 100rpx; }
.empty-hint { font-size: var(--font-sm); color: #ccc; margin-top: 8rpx; }
.empty-btn {
  margin-top: 32rpx; padding: 16rpx 48rpx; background: var(--color-primary);
  color: #fff; border-radius: var(--radius-round); font-size: var(--font-md);
}

/* 对比表 */
.compare-table {
  white-space: nowrap; padding: 20rpx 0;
  background: var(--color-bg); min-height: 100vh;
}
.ct-row { display: flex; min-height: 80rpx; align-items: center; }
.ct-row:nth-child(even) { background: var(--color-card); }
.ct-row:nth-child(odd) { background: #fafbff; }
.ct-header { background: var(--color-card) !important; min-height: 260rpx; align-items: flex-start; padding-top: 20rpx; }

/* 标签列 */
.ct-label-col {
  width: 120rpx; flex-shrink: 0; text-align: center;
  font-size: var(--font-sm); font-weight: 600; color: var(--color-text-secondary);
  padding: 0 8rpx;
}

/* 数据列 */
.ct-col {
  width: 220rpx; flex-shrink: 0; text-align: center;
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx; border-left: 1rpx solid #eee;
}

.ct-cover {
  width: 180rpx; height: 130rpx; border-radius: var(--radius-sm); margin-bottom: 8rpx;
}
.ct-title {
  font-size: var(--font-sm); font-weight: 600; color: var(--color-text-primary);
  white-space: normal; line-height: 1.4; margin-bottom: 6rpx;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.ct-remove {
  font-size: var(--font-xs); color: var(--color-danger); margin-top: 4rpx;
}
.ct-value { font-size: var(--font-md); color: var(--color-text-primary); }
.ct-value.price { font-size: var(--font-lg); font-weight: 700; color: var(--color-price); }

/* 底部 */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; gap: 20rpx; padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card); border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}
.bb-btn {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx; font-size: var(--font-lg); font-weight: 500;
}
.bb-btn.gray { background: var(--color-bg); color: var(--color-text-primary); }
.bb-btn.primary { background: var(--color-gradient); color: #fff; }
