/* 房源对比 - 卡片式 */
.cmp-container { min-height: 100vh; display: flex; flex-direction: column; padding-bottom: 130rpx; }

/* 空状态复用全局 empty-state */

/* 横向滚动 */
.cmp-scroll { white-space: nowrap; padding: 24rpx; }
.cmp-card {
  display: inline-block; width: 300rpx; background: var(--color-card);
  border-radius: var(--radius-lg); overflow: hidden; margin-right: 20rpx;
  box-shadow: var(--shadow-md); vertical-align: top; white-space: normal;
  animation: fadeInUp 0.35s ease both;
}
.cmp-card:last-child { margin-right: 0; }

.cmp-img-wrap { position: relative; }
.cmp-img { width: 100%; height: 200rpx; }
.cmp-remove {
  position: absolute; top: 12rpx; right: 12rpx;
  width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.5); color: #fff;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx;
}

.cmp-body { padding: 20rpx; }
.cmp-title {
  font-size: var(--font-sm); font-weight: 600; color: var(--color-text-primary);
  line-height: 1.4; margin-bottom: 12rpx;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.cmp-price {
  font-size: var(--font-xl); font-weight: 700; color: var(--color-price);
  margin-bottom: 16rpx; padding-bottom: 16rpx; border-bottom: 1rpx dashed #eee;
}
.cmp-price-unit { font-size: var(--font-sm); font-weight: 400; }

.cmp-row { display: flex; justify-content: space-between; padding: 10rpx 0; }
.cmp-row:nth-child(even) { background: #fafbfe; margin: 0 -20rpx; padding: 10rpx 20rpx; }
.cmp-label { font-size: var(--font-xs); color: var(--color-text-hint); }
.cmp-val { font-size: var(--font-sm); color: var(--color-text-primary); font-weight: 500; }

/* 底部 */
.cmp-bottom {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; gap: 20rpx; padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card); border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}
.cmpb-btn {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx; font-size: var(--font-lg); font-weight: 500;
}
.cmpb-btn.gray { background: var(--color-bg); color: var(--color-text-primary); }
.cmpb-btn.primary { background: var(--color-gradient); color: #fff; }
