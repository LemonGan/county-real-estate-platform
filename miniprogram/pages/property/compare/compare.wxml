<!-- 房源对比 -->
<view class="cmp-container">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{list.length === 0}}">
    <text class="empty-state-icon">⚖️</text>
    <text class="empty-state-text">还没有添加对比房源</text>
    <text class="empty-state-hint">在房源详情页点击"对比"加入</text>
    <view class="empty-state-btn" bindtap="goToList">去看看房源</view>
  </view>

  <!-- 对比卡片列表 -->
  <scroll-view class="cmp-scroll" scroll-x wx:if="{{list.length > 0}}">
    <view class="cmp-card" wx:for="{{list}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <!-- 房源图 -->
      <view class="cmp-img-wrap">
        <image class="cmp-img" src="{{item.coverUrl || '/assets/images/placeholder.png'}}" mode="aspectFill"/>
        <view class="cmp-remove" catchtap="removeItem" data-id="{{item.id}}">✕</view>
      </view>
      <!-- 信息 -->
      <view class="cmp-body">
        <text class="cmp-title ellipsis-2">{{item.title}}</text>
        <view class="cmp-price">¥{{item.price / 10000}}<text class="cmp-price-unit">万</text></view>
        <view class="cmp-row">
          <text class="cmp-label">面积</text>
          <text class="cmp-val">{{item.area}}㎡</text>
        </view>
        <view class="cmp-row">
          <text class="cmp-label">户型</text>
          <text class="cmp-val">{{item.rooms}}室{{item.halls}}厅</text>
        </view>
        <view class="cmp-row">
          <text class="cmp-label">朝向</text>
          <text class="cmp-val">{{item.orientation || '--'}}</text>
        </view>
        <view class="cmp-row">
          <text class="cmp-label">楼层</text>
          <text class="cmp-val">{{item.floor || '--'}}</text>
        </view>
        <view class="cmp-row">
          <text class="cmp-label">装修</text>
          <text class="cmp-val">{{item.decoration || '--'}}</text>
        </view>
        <view class="cmp-row">
          <text class="cmp-label">年代</text>
          <text class="cmp-val">{{item.buildYear || '--'}}年</text>
        </view>
        <view class="cmp-row">
          <text class="cmp-label">区域</text>
          <text class="cmp-val">{{item.district || '--'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部 -->
  <view class="cmp-bottom" wx:if="{{list.length > 0}}">
    <view class="cmpb-btn gray" bindtap="clearAll">清空</view>
    <view class="cmpb-btn primary" bindtap="goToList">添加更多</view>
  </view>
</view>
