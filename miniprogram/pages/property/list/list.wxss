/* 房源列表页样式 - 修复版 */
.page-container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 顶部工具栏 */
.top-toolbar {
  display: flex; align-items: center;
  background: var(--color-card); padding: 20rpx 24rpx;
}

/* 搜索栏 */
.search-bar { padding: 0; }
.search-input {
  display: flex; align-items: center;
  background: var(--color-bg); border-radius: var(--radius-round);
  padding: 20rpx 24rpx; justify-content: space-between;
}
.search-placeholder { color: #bbb; font-size: var(--font-md); }
.search-icon-text { font-size: 32rpx; opacity: 0.4; }

/* 视图切换按钮 */
.view-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
}

.toggle-icon {
  width: 40rpx;
  height: 40rpx;
}

.toggle-text {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 30rpx;
}

/* 地图视图 */
.map-view {
  position: fixed;
  top: 180rpx;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

.property-map {
  width: 100%;
  height: 100%;
}

/* 地图房源卡片 */
.map-property-card {
  position: absolute;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  transform: translateY(120%);
  transition: transform 0.3s ease;
}

.map-property-card.show {
  transform: translateY(0);
}

.card-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 10;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
}

.card-close .close-icon {
  width: 32rpx;
  height: 32rpx;
}

.map-property-card .card-content {
  display: flex;
  padding: 20rpx;
}

.map-property-card .card-image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.map-property-card .card-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.map-property-card .card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-property-card .card-tags {
  display: flex;
  gap: 10rpx;
}

.map-property-card .card-tags .tag {
  padding: 6rpx 12rpx;
  background: #f0f2f5;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.map-property-card .card-price {
  display: flex;
  align-items: baseline;
}

.map-property-card .card-price .price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.map-property-card .card-price .unit {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

.filter-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #f8f9fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #333;
}

.filter-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.sort-item {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.sort-item.active {
  color: #667eea;
  font-weight: 500;
}

/* 房源卡片 */
.property-item {
  background: var(--color-card); margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg); overflow: hidden;
  box-shadow: var(--shadow-md); transition: transform 0.15s;
}
.property-item:active { transform: scale(0.98); }

.property-thumb {
  width: 100%;
  height: 360rpx;
}

.property-tag {
  position: absolute; top: 20rpx; left: 20rpx;
  padding: 8rpx 20rpx; background: var(--color-gradient);
  color: #fff; font-size: var(--font-xs); border-radius: 20rpx;
}

.property-content { padding: 24rpx; }

.property-title {
  font-size: var(--font-lg); font-weight: 600;
  color: var(--color-text-primary); margin-bottom: 12rpx;
}

.property-tags {
  margin-bottom: 16rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.tag-primary {
  background: #e6e9ff;
  color: #667eea;
}

.tag-success {
  background: #e6f7e6;
  color: #52c41a;
}

.tag-warning {
  background: #fff7e6;
  color: #fa8c16;
}

.property-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.price-integer {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.price-unit {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

.property-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.property-location {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.location-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-text {
  font-size: 26rpx;
  color: #667eea;
}

/* 加载中 */
.loading {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
}

/* 底部占位 */
.bottom-space {
  height: 120rpx;
}


/* 房源列表容器 */
.property-list {
  padding: 20rpx 0;
}

/* 省略号 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 房源底部 */
.property-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

/* 单价 */
.property-unitprice {
  font-size: 24rpx;
  color: #999;
}

/* 筛选图标 */
.filter-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

/* 没有更多 */
.no-more {
  padding: 32rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

/* 筛选面板 */
.filter-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.filter-panel.show {
  transform: translateY(0);
}

.filter-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-title {
  font-size: 32rpx;
  font-weight: 600;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
}

.filter-body {
  padding: 30rpx;
  max-height: 60vh;
}

.filter-section {
  margin-bottom: 40rpx;
}

.filter-section-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.filter-row {
  display: flex;
  align-items: center;
}

.filter-input {
  flex: 1;
  height: 72rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.filter-separator {
  margin: 0 20rpx;
  color: #999;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.filter-option {
  padding: 16rpx 32rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.filter-option.active {
  background: #e6e9ff;
  color: #667eea;
}

.filter-footer {
  display: flex;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-default {
  background: #f8f9fa;
  color: #333;
  margin-right: 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 空按钮 */
.empty-btn {
  margin-top: 30rpx;
  padding: 20rpx 60rpx;
  background: #667eea;
  color: #fff;
  border-radius: 40rpx;
  display: inline-block;
}
