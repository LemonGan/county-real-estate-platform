/* 房贷计算器 */
.calc-container { padding: 20rpx 24rpx; }

/* 卡片 */
.calc-card {
  background: var(--color-card); border-radius: var(--radius-lg);
  padding: 28rpx 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm);
}
.calc-title { font-size: var(--font-lg); font-weight: 600; margin-bottom: 20rpx; color: var(--color-text-primary); }

/* 金额输入 */
.price-input-row {
  display: flex; align-items: center; margin-bottom: 20rpx;
}
.price-unit { font-size: var(--font-xl); color: var(--color-text-secondary); margin-right: 12rpx; }
.price-input {
  flex: 1; font-size: 52rpx; font-weight: 700;
  color: var(--color-text-primary); border-bottom: 3rpx solid var(--color-border); padding: 8rpx 0;
}
.price-suffix { font-size: var(--font-md); color: var(--color-text-hint); margin-left: 12rpx; }

/* 快捷金额 */
.quick-prices { display: flex; gap: 12rpx; }
.qp-item {
  flex: 1; text-align: center; padding: 12rpx 0;
  background: var(--color-bg); border-radius: 12rpx;
  font-size: var(--font-sm); color: var(--color-text-secondary);
}
.qp-item.active { background: var(--color-primary); color: #fff; font-weight: 600; }

/* 首付比例 */
.ratio-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.ratio-item {
  flex: 1; text-align: center; padding: 16rpx 0;
  background: var(--color-bg); border-radius: 12rpx;
  font-size: var(--font-md); font-weight: 600; color: var(--color-text-secondary);
}
.ratio-item.active { background: var(--color-gradient); color: #fff; }

.info-row { display: flex; justify-content: space-between; padding: 10rpx 0; }
.info-label { font-size: var(--font-sm); color: var(--color-text-hint); }
.info-value { font-size: var(--font-md); color: var(--color-text-primary); font-weight: 600; }
.info-value.highlight { color: var(--color-primary); font-size: var(--font-lg); }

/* 参数行 */
.param-row { display: flex; gap: 30rpx; margin-bottom: 20rpx; }
.param-item { flex: 1; }
.param-label { display: block; font-size: var(--font-sm); color: var(--color-text-hint); margin-bottom: 8rpx; }
.rate-input-wrap { display: flex; align-items: center; }
.rate-symbol { font-size: var(--font-sm); color: var(--color-text-hint); }
.rate-input { width: 100rpx; font-size: var(--font-xl); font-weight: 700; text-align: center; color: var(--color-text-primary); }
.picker-display {
  font-size: var(--font-xl); font-weight: 700; color: var(--color-text-primary);
  padding: 8rpx 0; border-bottom: 3rpx solid var(--color-border);
}

/* 还款方式 */
.payment-tabs { display: flex; gap: 16rpx; }
.pt-item {
  flex: 1; text-align: center; padding: 16rpx 0;
  background: var(--color-bg); border-radius: 12rpx;
  font-size: var(--font-md); color: var(--color-text-secondary);
}
.pt-item.active { background: var(--color-gradient); color: #fff; font-weight: 600; }

/* 结果 */
.result-card {
  background: var(--color-card); border-radius: var(--radius-lg);
  padding: 28rpx 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm);
  animation: fadeInUp 0.3s ease both;
}
.result-header { font-size: var(--font-lg); font-weight: 600; margin-bottom: 20rpx; }
.result-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.rg-item { text-align: center; }
.rg-value { display: block; font-size: var(--font-xl); font-weight: 700; color: var(--color-text-primary); }
.rg-value.primary { color: var(--color-price); font-size: var(--font-xxl); }
.rg-label { font-size: var(--font-xs); color: var(--color-text-hint); margin-top: 4rpx; }

/* 计算按钮 */
.calc-btn {
  margin: 20rpx 0; padding: 24rpx 0; text-align: center;
  background: var(--color-gradient); color: #fff;
  border-radius: var(--radius-round); font-size: var(--font-lg); font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(102,126,234,0.35);
}
.calc-btn:active { opacity: 0.85; }
