/* 经纪人房源管理页面样式 - 现代风格 */
.container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 标签切换 */
.tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 30rpx;
  margin: 0 10rpx;
  background: #f8f9fa;
}

.tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 房源列表 */
.property-list {
  padding: 30rpx;
}

.property-item {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.property-cover {
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.property-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.property-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.property-address {
  font-size: 24rpx;
  color: #999;
}

.property-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.tag.price {
  background: #fff7e6;
  color: #fa8c16;
  font-weight: 600;
}

.property-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.stat-item {
  font-size: 22rpx;
  color: #999;
}

/* 操作按钮 */
.action-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border-radius: 20rpx;
  background: #f8f9fa;
  color: #666;
}

.action-btn.primary {
  background: #e6e9ff;
  color: #667eea;
}

.action-btn.sold {
  background: #fff0f0;
  color: #c44949;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
}

/* 底部按钮 */
.add-btn {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  font-size: 60rpx;
  color: #fff;
}
.audit-note {
  display: block;
  margin-top: 8rpx;
  color: #a35c00;
  font-size: 24rpx;
  line-height: 1.4;
}
