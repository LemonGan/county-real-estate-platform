/* pages/agent/detail/detail.wxss */
.agent-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 加载容器 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #fff;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(102, 126, 234, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 经纪人卡片 */
.agent-card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.agent-header {
  display: flex;
  padding: 32rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.agent-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.agent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.agent-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.agent-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}

.verified-icon {
  width: 32rpx;
  height: 32rpx;
}

.agent-company {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.agent-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  padding: 4rpx 12rpx;
  background-color: #e6e9ff;
  color: #667eea;
  border-radius: 4rpx;
  font-size: 22rpx;
}

/* 服务数据 */
.service-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background-color: #e8e8e8;
}

/* 个人简介 */
.agent-intro {
  padding: 24rpx 32rpx;
  background-color: #f9f9f9;
}

.intro-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background-color: #667eea;
  color: #fff;
}

.action-btn.secondary {
  background-color: #fff;
  color: #667eea;
  border: 1rpx solid #667eea;
}

.action-btn.following {
  background-color: #f5f5f5;
  color: #999;
  border: 1rpx solid #e8e8e8;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 房源区域 */
.properties-section {
  margin: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: #fff;
  border-radius: 16rpx 16rpx 0 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 房源列表 */
.property-list {
  background-color: #fff;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
}

.property-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.property-item:last-child {
  border-bottom: none;
}

.property-thumb {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.property-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.property-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.property-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.property-price {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.price-unit {
  font-size: 20rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

/* 加载更多 */
.load-more {
  padding: 32rpx;
  text-align: center;
  background-color: #fff;
  border-radius: 0 0 16rpx 16rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #667eea;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  background-color: #fff;
  border-radius: 0 0 16rpx 16rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}
