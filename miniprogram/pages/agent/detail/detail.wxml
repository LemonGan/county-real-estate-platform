<view class="agent-page">
  <view class="loading-container" wx:if="{{loading}}"><view class="loading-spinner"></view></view>

  <view class="agent-detail" wx:if="{{!loading && agent}}">
    <view class="agent-card">
      <view class="agent-header">
        <image class="agent-avatar" src="{{agent.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="agent-info">
          <view class="agent-name-row">
            <text class="agent-name">{{agent.nickname}}</text>
            <image class="verified-icon" src="/assets/icons/verified.png" wx:if="{{agent.is_verified}}" />
          </view>
          <view class="agent-company" wx:if="{{agent.company}}">{{agent.company}}</view>
          <view class="agent-company" wx:else>已审核经纪人</view>
        </view>
      </view>

      <view class="service-stats">
        <view class="stat-item"><text class="stat-value">{{agent.property_count}}</text><text class="stat-label">在售房源</text></view>
        <view class="stat-divider"></view>
        <view class="stat-item"><text class="stat-value">{{agent.service_count}}</text><text class="stat-label">已完成服务</text></view>
        <view class="stat-divider"></view>
        <view class="stat-item"><text class="stat-value">{{agent.sales_count}}</text><text class="stat-label">已售房源</text></view>
      </view>
    </view>

    <view class="action-buttons">
      <button class="action-btn secondary {{isFollowed ? 'following' : ''}}" bindtap="onFollow" loading="{{followLoading}}" disabled="{{followLoading}}">
        {{isFollowed ? '已关注' : '+ 关注'}}{{followerCount ? ' · ' + followerCount + '人关注' : ''}}
      </button>
    </view>

    <view class="properties-section">
      <view class="section-header">
        <text class="section-title">Ta的在售房源</text>
        <text class="section-count">共{{agent.property_count}}套</text>
      </view>
      <view class="property-list" wx:if="{{properties.length}}">
        <view class="property-item" wx:for="{{properties}}" wx:key="id" bindtap="goToPropertyDetail" data-id="{{item.id}}">
          <image class="property-thumb" src="{{item.displayImage}}" mode="aspectFill" />
          <view class="property-content">
            <view class="property-title ellipsis">{{item.title}}</view>
            <view class="property-meta"><text class="meta-item">{{item.area || '--'}}㎡</text><text class="meta-item">{{item.rooms || 0}}室</text></view>
            <view class="property-price"><text class="price-value">{{item.priceText}}</text></view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:else><image class="empty-icon" src="/assets/images/default-property.png" /><view class="empty-text">暂无公开在售房源</view></view>
      <view class="load-more" wx:if="{{hasMore && properties.length}}" bindtap="loadMore"><text class="load-more-text">查看更多房源</text></view>
      <view class="load-more" wx:if="{{loadingMore}}"><text class="load-more-text">加载中...</text></view>
    </view>
  </view>

  <view class="empty-state page-empty" wx:if="{{!loading && loadError}}">
    <image class="empty-icon" src="/assets/images/default-avatar.png" />
    <view class="empty-text">该经纪人暂不可查看</view>
    <button class="back-btn" bindtap="goBack">返回上一页</button>
  </view>
</view>
