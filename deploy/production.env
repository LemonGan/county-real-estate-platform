# 县域房产平台 - 生产部署 .env
# Template only. Copy this file to backend/.env on the server and set real values there.
# 部署路径: /www/wwwroot/my_work/buyHouse/backend/.env

# 数据库配置 (替换为你在宝塔面板创建的数据库密码)
DATABASE_URL=mysql+asyncmy://xqfc_user:替换为你的数据库密码@localhost:3306/xqfc_db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# 安全配置 (已生成随机密钥)
SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET

# 调试模式 - 生产环境必须关闭
DEBUG=false
ENVIRONMENT=production

# CORS配置 (小程序请求源)
BACKEND_CORS_ORIGINS=https://8.138.129.142,https://servicewechat.com

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/www/wwwroot/my_work/buyHouse/uploads
STATIC_DIR=/www/wwwroot/my_work/buyHouse/static

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/www/wwwroot/my_work/buyHouse/logs/app.log

# 微信小程序配置 (在微信公众平台获取)
WECHAT_APPID=你的小程序AppID
WECHAT_SECRET=你的小程序AppSecret

# 腾讯地图配置 (在腾讯位置服务获取)
TENCENT_MAP_KEY=你的腾讯地图Key
TENCENT_MAP_SK=你的腾讯地图SK
